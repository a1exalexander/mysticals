# Google OAuth "Desktop app" client from Google Cloud Console (APIs & Services > Credentials),
# shared by apps/desktop and apps/terminal and embedded into both at build time.
# Build-time env vars of the same name win over this file. For installed apps the secret
# is not confidential, but keep it out of git anyway.
MYSTICALS_GOOGLE_CLIENT_ID=
MYSTICALS_GOOGLE_CLIENT_SECRET=

# PostHog (EU) project key for the anonymous usage stats, embedded into both apps at build time.
# Optional: unset means no telemetry at all.
MYSTICALS_POSTHOG_KEY=

# Apple Developer Team ID (10 characters). Baked into the macOS desktop app so the updater only
# installs bundles signed by this team. Optional locally: unset skips the check.
MYSTICALS_APPLE_TEAM_ID=

# macOS signing and notarization happen in CI only (GitHub secrets, see CONTRIBUTING.md > Releasing):
# CSC_LINK, CSC_KEY_PASSWORD, APPLE_API_KEY_P8, APPLE_API_KEY_ID, APPLE_API_ISSUER.

# NPM_TOKEN is used to publish the package to npm. It is not used by the apps themselves.
NPM_TOKEN=