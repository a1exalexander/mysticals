---
import '../styles/global.css'
interface Props { title: string; description?: string }
const { title, description = 'One calendar for all your Google and CalDAV accounts. Free, local, no sign-up.' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href="/"><img src="/icon.svg" alt="" width="28" height="28" />Mysticals</a>
      <nav><a href="/desktop">Desktop</a><a href="/terminal">Terminal</a><a href="https://github.com/a1exalexander/mysticals">GitHub</a></nav>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap foot">Free · Local · No account needed · <a href="https://github.com/a1exalexander/mysticals">GitHub</a></footer>
  </body>
</html>
