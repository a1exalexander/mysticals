---
import '../styles/global.css'
interface Props { title: string; description?: string }
const { title, description = 'A calendar for several Google and CalDAV accounts, on the desktop or in your terminal. Every account stays in its own box.' } = Astro.props
const here = Astro.url.pathname.replace(/\/$/, '') || '/'
const gh = 'https://github.com/a1exalexander/mysticals'
const cur = (href: string) => (here === href ? 'page' : undefined)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b10" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="wrap nav">
        <a class="brand" href="/"><img src="/icon.svg" alt="" width="34" height="34" />mysticals</a>
        <nav>
          <a class="sec" href="/#isolation">Isolation</a>
          <a class="sec" href="/#apps">Desktop &amp; Terminal</a>
          <a class="sec" href="/#why">Why</a>
          <a href="/install" aria-current={cur('/install')}>Install</a>
          <a class="gh" href={gh}>GitHub</a>
          <a class="btn" href="/download" aria-current={cur('/download')}>Download</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="wrap foot">
      <span class="mono">mysticals · MIT · © Oleksandr Ratushnyi</span>
      <nav>
        <a href="/">Home</a><a href="/download">Download</a><a href="/install">Install</a>
        <a href={gh}>GitHub</a><a href="https://www.npmjs.com/package/mysticals">npm</a>
      </nav>
    </footer>
    <script>
      // <button data-copy="text"> copies its text and says so for a moment
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        const label = b.querySelector('.lbl')
        b.addEventListener('click', async () => {
          await navigator.clipboard.writeText(b.dataset.copy!)
          if (!label) return
          const was = label.textContent
          label.textContent = 'copied'
          setTimeout(() => (label.textContent = was), 1500)
        })
      }
    </script>
  </body>
</html>

