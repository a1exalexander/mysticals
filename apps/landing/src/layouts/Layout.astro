---
import '../styles/global.css'
import Analytics from '../components/Analytics.astro'
import { PREVIEW } from '../preview'
import { bare, langOf, to } from '../i18n'
interface Props { title: string; description?: string }
const lang = langOf(Astro.url)
const t = {
  en: {
    description: 'A calendar for several Google and CalDAV accounts, on the desktop or in your terminal. Every account stays in its own box.',
    ogAlt: 'Mysticals logo: all your calendars, none of them mixed up',
    madeIn: 'Made in Ukraine',
    why: 'Why', themes: 'Themes', isolation: 'Isolation', apps: 'Apps', install: 'Install', download: 'Download', follow: 'Follow on GitHub',
    preview: '<b>In development.</b> Mysticals isn’t available for download yet: Google is still reviewing its calendar access. Follow along on',
    author: 'Oleksandr Ratushnyi',
    stats: 'Anonymous, cookie-free stats via PostHog.', details: 'Details',
    home: 'Home', privacy: 'Privacy', terms: 'Terms', donate: 'Donate',
    theme: 'Theme', system: 'Same as system', light: 'Light', dark: 'Dark', language: 'Language',
  },
  uk: {
    description: 'Календар для кількох акаунтів Google і CalDAV, на десктопі або просто в терміналі. Кожен акаунт живе окремо.',
    ogAlt: 'Логотип Mysticals: усі календарі, і жодної плутанини',
    madeIn: 'Зроблено в Україні',
    why: 'Навіщо', themes: 'Теми', isolation: 'Ізоляція', apps: 'Застосунки', install: 'Встановлення', download: 'Завантажити', follow: 'Стежити на GitHub',
    preview: '<b>Ще в розробці.</b> Завантажити Mysticals поки не можна: Google перевіряє його доступ до календарів. Стежте за новинами на',
    author: 'Олександр Ратушний',
    stats: 'Анонімна статистика без cookie через PostHog.', details: 'Докладніше',
    home: 'Головна', privacy: 'Конфіденційність', terms: 'Умови', donate: 'Підтримати',
    theme: 'Тема', system: 'Як у системі', light: 'Світла', dark: 'Темна', language: 'Мова',
  },
}[lang]
const { title, description = t.description } = Astro.props
const path = bare(Astro.url)
const href = (p: string) => to(lang, p)
const cur = (p: string) => (path.replace(/\/$/, '') === p.replace(/\/$/, '') ? 'page' : undefined)
const gh = 'https://github.com/a1exalexander/mysticals'
const donate = 'https://base.monobank.ua/4VzJ6ms12UeMhR#donate'
const abs = (p: string) => new URL(p, Astro.site).href
const ogImage = abs('/og-image.png')
const phKey = process.env.MYSTICALS_POSTHOG_KEY
const icons = {
  system: '<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  light: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  dark: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
} as const
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before the first paint: the saved theme (none = follow the system), then the language. A saved language wins;
      // otherwise the root (English) pages send browsers that prefer Ukrainian over English to /uk/.
      try {
        const th = localStorage.getItem('theme')
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th
        const p = location.pathname
        const onUk = /^\/uk(\/|$)/.test(p)
        let want = localStorage.getItem('lang')
        if (!want && !onUk) want = (navigator.languages || [navigator.language]).map((l) => l.slice(0, 2).toLowerCase()).find((l) => l === 'uk' || l === 'en')
        const rest = location.search + location.hash
        if (want === 'uk' && !onUk) location.replace('/uk' + p + rest)
        else if (want === 'en' && onUk) location.replace((p.replace(/^\/uk/, '') || '/') + rest)
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={abs(href(path))} />
    <link rel="alternate" hreflang="en" href={abs(path)} />
    <link rel="alternate" hreflang="uk" href={abs(to('uk', path))} />
    <link rel="alternate" hreflang="x-default" href={abs(path)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mysticals" />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(href(path))} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap" />
    <title>{title}</title>
    {phKey && <Analytics apiKey={phKey} />}
  </head>
  <body>
    <div class="ua-bar">
      <span class="ua-pill"><svg class="ua-flag" viewBox="0 0 3 2" aria-hidden="true"><rect width="3" height="1" fill="#0057B7" /><rect y="1" width="3" height="1" fill="#FFD700" /></svg>{t.madeIn}</span>
    </div>
    <header>
      <div class="wrap nav">
        <a class="brand" href={href('/')}><img src="/icon.svg" alt="" width="30" height="30" />mysticals</a>
        <nav>
          <a class="sec" href={href('/#why')}>{t.why}</a>
          <a class="sec" href={href('/#themes')}>{t.themes}</a>
          <a class="sec" href={href('/#isolation')}>{t.isolation}</a>
          <a class="sec" href={href('/#apps')}>{t.apps}</a>
          {!PREVIEW && <a class="inst" href={href('/install/')} aria-current={cur('/install/')}>{t.install}</a>}
          <a class="gh" href={gh}>GitHub</a>
          {PREVIEW ? <a class="btn" href={gh}>{t.follow}</a> : <a class="btn" href={href('/download/')} aria-current={cur('/download/')}>{t.download}</a>}
        </nav>
      </div>
    </header>
    {PREVIEW && (
      <div class="preview-bar" role="status">
        <div class="wrap"><Fragment set:html={t.preview} /> <a class="ul" href={gh}>GitHub</a>.</div>
      </div>
    )}
    <main><slot /></main>
    <footer class="wrap foot">
      <div class="frow">
        <span class="mono">mysticals · MIT · © <a class="ul" href="https://www.sashkoratushnyi.com/">{t.author}</a></span>
        <nav>
          <a href={href('/')}>{t.home}</a>{!PREVIEW && <><a href={href('/download/')}>{t.download}</a><a href={href('/install/')}>{t.install}</a></>}
          <a href={gh}>GitHub</a>{!PREVIEW && <a href="https://www.npmjs.com/package/mysticals">npm</a>}
          <a href={href('/privacy/')}>{t.privacy}</a><a href={href('/terms/')}>{t.terms}</a>
          <a class="donate" href={donate} data-track="donate_click"><img src="/monobank-base.png" alt="" width="18" height="18" />{t.donate}</a>
        </nav>
      </div>
      <div class="frow">
        {phKey ? <span>{t.stats} <a class="ul" href={href('/privacy/#website')}>{t.details}</a></span> : <span />}
        <div class="prefs">
          <div class="seg" role="group" aria-label={t.theme}>
            {(['system', 'light', 'dark'] as const).map((k) => (
              <button type="button" data-set-theme={k} aria-pressed={k === 'system' ? 'true' : 'false'} aria-label={t[k]} title={t[k]}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[k]} />
              </button>
            ))}
          </div>
          <div class="seg" role="group" aria-label={t.language}>
            <a href={path} hreflang="en" lang="en" data-set-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <a href={to('uk', path)} hreflang="uk" lang="uk" data-set-lang="uk" aria-current={lang === 'uk' ? 'true' : undefined}>УКР</a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const store = (k: string, v: string | null) => {
        try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v) } catch {}
      }
      // <button data-copy="text"> copies its text and says so for a moment
      const copied = document.documentElement.lang === 'uk' ? 'скопійовано' : 'copied'
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        const label = b.querySelector('.lbl')
        b.addEventListener('click', async () => {
          await navigator.clipboard.writeText(b.dataset.copy!)
          if (!label) return
          const was = label.textContent
          label.textContent = copied
          setTimeout(() => (label.textContent = was), 1500)
        })
      }
      // Theme: system (nothing saved), light or dark; the head script applies the saved one before paint
      const root = document.documentElement
      const themeBtns = document.querySelectorAll<HTMLButtonElement>('[data-set-theme]')
      const showTheme = () => themeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === (root.dataset.theme ?? 'system'))))
      themeBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const th = b.dataset.setTheme!
          if (th === 'system') delete root.dataset.theme
          else root.dataset.theme = th
          store('theme', th === 'system' ? null : th)
          showTheme()
        }),
      )
      showTheme()
      // Picking a language sticks, so the head script stops guessing from the browser
      document.querySelectorAll<HTMLElement>('[data-set-lang]').forEach((a) => a.addEventListener('click', () => store('lang', a.dataset.setLang!)))
    </script>
  </body>
</html>
