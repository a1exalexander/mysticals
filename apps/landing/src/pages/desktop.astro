---
import Layout from '../layouts/Layout.astro'
const releases = 'https://github.com/a1exalexander/multicals/releases/latest'
---
<Layout title="Multicals for desktop — install and use">
  <h1>Multicals for <span class="grad">desktop</span></h1>
  <p class="lead">All your Google and CalDAV calendars in one window. Free. No sign-up. Your data stays on your computer.</p>
  <div class="pills os">
    <a class="pill" href="#macos">macOS</a>
    <a class="pill" href="#windows">Windows</a>
    <a class="pill" href="#linux">Linux</a>
  </div>
  <p><a class="btn" href={releases}>Download the latest release</a></p>

  <h2>Install</h2>
  <div class="grid">
    <section class="card" id="macos">
      <h3>macOS</h3>
      <ol class="steps">
        <li>Download the <code>.dmg</code> for your Mac (Apple silicon or Intel).</li>
        <li>Open it and drag Multicals into Applications.</li>
        <li>First launch: right-click the app → <strong>Open</strong>. The app is not signed yet, so macOS asks once.</li>
      </ol>
    </section>
    <section class="card" id="windows">
      <h3>Windows</h3>
      <ol class="steps">
        <li>Download the <code>.exe</code> installer.</li>
        <li>Run it. If SmartScreen appears, click <strong>More info → Run anyway</strong>.</li>
        <li>Start Multicals from the Start menu.</li>
      </ol>
    </section>
    <section class="card" id="linux">
      <h3>Linux</h3>
      <ol class="steps">
        <li>Download the <code>.AppImage</code>.</li>
        <li>Make it executable and run it:</li>
      </ol>
      <pre><code>chmod +x Multicals-*.AppImage
./Multicals-*.AppImage</code></pre>
    </section>
  </div>

  <h2>Use</h2>
  <div class="grid">
    <section class="card">
      <h3>Add a Google account</h3>
      <p>Click <strong>Google</strong>. Your browser opens. Sign in and allow access. Done. Repeat for every Google account you have.</p>
    </section>
    <section class="card">
      <h3>Add a CalDAV account</h3>
      <p>Click <strong>CalDAV</strong> and pick a provider, or enter your own server.</p>
      <table>
        <tr><th>Server URL</th><td>Filled in for known providers</td></tr>
        <tr><th>Email</th><td><code>you@company.com</code></td></tr>
        <tr><th>App password</th><td>Make one in your provider's settings</td></tr>
        <tr><th>Label</th><td>e.g. “Work”</td></tr>
      </table>
      <p class="servers">iCloud <code>https://caldav.icloud.com/</code></p>
      <p class="servers">Fastmail <code>https://caldav.fastmail.com/</code></p>
    </section>
    <section class="card">
      <h3>Create an event</h3>
      <p>Pick the account and calendar every time. There is no default account, so nothing goes out from the wrong one.</p>
    </section>
    <section class="card">
      <h3>Answer invites</h3>
      <p>Accept, Maybe or Decline. The reply goes from the account that got the invite.</p>
    </section>
    <section class="card">
      <h3>Pick a theme</h3>
      <p>Open <strong>Settings → Themes</strong>. Try Dracula, Tokyo Night, Catppuccin Mocha or Phosphor amber.</p>
    </section>
    <section class="card">
      <h3>Private by design</h3>
      <p>No Multicals account. Events and credentials stay on your device. Credentials are encrypted.</p>
    </section>
  </div>
</Layout>

<style>
  .os { margin: 8px 0 24px; }
  .os .pill:hover { text-decoration: none; border-color: var(--line-strong); }
  section[id] { scroll-margin-top: 16px; }
  .card .steps { margin: 12px 0 0; }
  .card .steps > li:last-child { margin-bottom: 0; }
  .card pre { margin: 12px 0 0; font-size: 13px; }
  .card table { margin: 12px 0; font-size: 14px; }
  .card th { color: var(--fg); white-space: nowrap; font-weight: 600; }
  .card td { color: var(--muted); }
  .card code { overflow-wrap: anywhere; }
  .card p.servers { font-size: 14px; margin-top: 8px; }
  .card p.servers code { display: block; width: fit-content; margin-top: 4px; }
</style>
