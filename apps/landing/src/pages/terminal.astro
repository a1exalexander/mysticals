---
import Layout from '../layouts/Layout.astro'

const keys: [string[], string][] = [
  [['a', 'd', '2', 'w', 'm'], 'Agenda, Day, 2 Days, Week, Month'],
  [['←', '→'], 'Previous / next day (or h l)'],
  [['↑', '↓'], 'Previous / next event'],
  [['j', 'k'], 'Next / previous event in time order'],
  [['t'], 'Jump to today'],
  [['enter'], 'Open event'],
  [['n'], 'New event'],
  [['i'], 'Invites: y accept, n decline, m maybe'],
  [['s'], 'Accounts and calendars'],
  [['r'], 'Sync now'],
  [['?'], 'Help'],
  [['q'], 'Quit'],
]
---
<Layout title="Mysticals for the terminal — install and use">
  <h1>Mysticals for the <span class="grad">terminal</span></h1>
  <p class="lead">All your Google and CalDAV calendars in one keyboard-driven view. Free. No sign-up.</p>
  <div class="pills">
    <span class="pill">macOS</span><span class="pill">Windows</span><span class="pill">Linux</span><span class="pill">Node 20+</span>
  </div>

  <div class="term" aria-hidden="true">
    <div class="bar"><i></i><i></i><i></i></div>
    <pre><code><span class="p">$</span> npm i -g mysticals
<span class="p">$</span> mysticals
<span class="c"># or try the demo first</span>
<span class="p">$</span> MYSTICALS_MOCK=1 mysticals</code></pre>
  </div>

  <h2>Install</h2>
  <ol class="steps">
    <li>Install <a href="https://nodejs.org/">Node.js</a> 20 or newer.</li>
    <li>Install Mysticals: <code>npm i -g mysticals</code></li>
    <li>Run it: <code>mysticals</code></li>
  </ol>
  <p>Just looking? <code>MYSTICALS_MOCK=1 mysticals</code> opens a demo with fake accounts. It touches nothing real.</p>

  <h2>Add your accounts</h2>
  <p>Press <kbd>s</kbd>. Add as many as you like.</p>
  <div class="grid">
    <div class="card"><h3>Google</h3><p>Sign in in your browser. That's it.</p></div>
    <div class="card"><h3>CalDAV</h3><p>Server URL, username and an app password. iCloud, Fastmail and others.</p></div>
  </div>
  <p class="note">No Mysticals account. Data and credentials stay on your device, encrypted.</p>

  <h2>Keys</h2>
  <div class="keys card">
    <table>
      <tbody>
        {keys.map(([ks, what]) => (
          <tr><td>{ks.map((k) => <kbd>{k}</kbd>)}</td><td>{what}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Good to know</h2>
  <div class="grid">
    <div class="card"><h3>Mouse works</h3><p>Click to select, click again to open. The wheel scrolls.</p></div>
    <div class="card"><h3>Your theme</h3><p>Colours follow your terminal theme.</p></div>
    <div class="card"><h3>Many windows, one sync</h3><p>All open windows share one background process. It syncs once.</p></div>
  </div>
</Layout>

<style>
  .pills { margin-top: 16px; }
  .term { margin-top: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .term .bar { display: flex; gap: 6px; padding: 10px 14px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .term .bar i { width: 11px; height: 11px; border-radius: 50%; background: var(--pink); }
  .term .bar i:nth-child(2) { background: var(--accent); }
  .term .bar i:nth-child(3) { background: var(--green); }
  .term pre { margin: 0; border: 0; border-radius: 0; }
  .p { color: var(--green); }
  .c { color: var(--muted); }
  .note { color: var(--muted); }
  .keys { padding: 4px 12px; }
  .keys tr:last-child td { border-bottom: 0; }
  .keys td:first-child { white-space: nowrap; width: 1%; padding-right: 16px; }
  .keys kbd { margin-right: 4px; color: var(--accent); }
  .keys td:last-child { color: var(--muted); }
  @media (max-width: 480px) { .keys td { padding: 6px 4px; font-size: 14px; } .keys kbd { padding: 1px 4px; margin-right: 2px; } }
</style>
