---
import Layout from '../layouts/Layout.astro'
const gh = 'https://github.com/a1exalexander/mysticals'
const keys: [string[], string][] = [
  [['a', 'd', '2', 'w', 'm'], 'Agenda, Day, 2 Days, Week, Month'],
  [['←', '→'], 'Previous / next day (or h l); in Agenda, previous / next event'],
  [['↑', '↓'], 'Previous / next event within the selected day; in Agenda and Month, across days'],
  [['j', 'k'], 'Next / previous event in time order'],
  [['Shift ←', 'Shift →'], 'Previous / next page (or H L)'],
  [['t'], 'Jump to today'],
  [['enter'], 'Open event'],
  [['n'], 'New event'],
  [['i'], 'Invites: j k move, y accept, n decline, m maybe'],
  [['o', 'e', 'x', 'a'], 'In an open event: open meeting link, edit, delete (confirm y, or 1 2 3 for a repeating event), show all attendees; y n m reply; esc or q closes'],
  [['s'], 'Accounts and calendars'],
  [['r'], 'Sync now'],
  [['?'], 'Help'],
  [['q'], 'Quit'],
]
const apps = [['desktop', 'Desktop'], ['terminal', 'Terminal']]
const systems = [['mac', 'macOS'], ['windows', 'Windows'], ['linux', 'Linux']]
---
<Layout title="Install Mysticals" description="Install the Mysticals desktop or terminal app on macOS, Windows or Linux and connect Google and CalDAV calendars.">
  <section class="wrap page-head">
    <span class="eyebrow">$ man mysticals</span>
    <h1>Install guide</h1>
    <p class="lead">Pick an app and your system. Five minutes from download to your first synced calendar.</p>
  </section>

  <section class="wrap pickers">
    <div class="picker" role="group" aria-label="App">
      <span class="eyebrow">app</span>
      <div class="seg">{apps.map(([id, l], i) => <button type="button" data-app={id} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}</div>
    </div>
    <div class="picker" role="group" aria-label="System">
      <span class="eyebrow">system</span>
      <div class="seg">{systems.map(([id, l], i) => <button type="button" data-os={id} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}</div>
    </div>
  </section>

  <section class="wrap guide">
    <div class="panels">
      <ol class="steps" data-panel="desktop-mac">
        <li><div><h3>Download the .dmg for your chip</h3>
          <p>Apple menu → About This Mac. “Chip: Apple M…” → <code>arm64</code>. “Processor: Intel…” → <code>x64</code>.</p>
          <a class="btn" href="/download/">Go to downloads</a></div></li>
        <li><div><h3>Drag Mysticals into Applications</h3>
          <p>Open the .dmg, drag the icon onto the Applications folder, then eject the disk image.</p></div></li>
        <li><div><h3>Open it the first time</h3>
          <p>Mysticals isn’t notarized by Apple, so macOS blocks the first launch. Open it from Applications, click Done, then go to System Settings → Privacy &amp; Security and click “Open Anyway”. Or from the terminal:</p>
          <div class="code"><div>xattr -dr com.apple.quarantine /Applications/Mysticals.app</div></div></div></li>
        <li><div><h3>Add your first account</h3>
          <p>Add calendar → Google (sign in in the browser) or CalDAV (pick a preset below). Give it a label and a colour. Repeat for every account — each one gets its own box.</p></div></li>
        <li><div><h3>That’s it. Updates are automatic</h3>
          <p>The app downloads new releases for your architecture and updates itself.</p></div></li>
      </ol>

      <ol class="steps" data-panel="desktop-windows" hidden>
        <li><div><h3>Download the setup .exe</h3>
          <p><code>Mysticals-…-x64-setup.exe</code> from the latest release.</p>
          <a class="btn" href="/download/">Go to downloads</a></div></li>
        <li><div><h3>Run the installer</h3>
          <p>Mysticals is shared unsigned, so SmartScreen warns about an unknown publisher. Click More info → Run anyway, then follow the installer. It asks whether to install just for you or for everyone on this computer (that one needs admin rights) and lets you pick the folder.</p></div></li>
        <li><div><h3>Add your first account</h3>
          <p>Add calendar → Google (sign in in the browser) or CalDAV (pick a preset below). Give it a label and a colour. Repeat for every account — each one gets its own box. Credentials are sealed with Windows DPAPI for your user.</p></div></li>
        <li><div><h3>Updates</h3>
          <p>When a new release is out, the status bar offers it. Click it to open the release page and run the new setup .exe over the old one.</p></div></li>
      </ol>

      <ol class="steps" data-panel="desktop-linux" hidden>
        <li><div><h3>Download the AppImage or .deb</h3>
          <p><code>Mysticals-…-x86_64.AppImage</code> runs on most distros. On Debian or Ubuntu you can take the <code>.deb</code> instead.</p>
          <a class="btn" href="/download/">Go to downloads</a></div></li>
        <li><div><h3>Install or run it</h3>
          <div class="code"><div>chmod +x Mysticals-*.AppImage &amp;&amp; ./Mysticals-*.AppImage</div><div class="c"># or</div><div>sudo apt install ./Mysticals-*-amd64.deb</div></div></div></li>
        <li><div><h3>Make sure a keyring is running</h3>
          <p>Credentials are encrypted with the Secret Service (GNOME Keyring, KWallet). GNOME and KDE desktops have one already. Without one, Mysticals refuses to store credentials rather than keep them in plain text.</p></div></li>
        <li><div><h3>Add your first account</h3>
          <p>Add calendar → Google (sign in in the browser) or CalDAV (pick a preset below). Repeat for every account — each one gets its own box. New releases show up in the status bar and open the release page.</p></div></li>
      </ol>

      <div data-panel="terminal" hidden>
        <ol class="steps">
          <li><div><h3>Check Node.js 20.3+</h3>
            <p>No Node yet? Install it from nodejs.org, Homebrew (<code>brew install node</code>), winget (<code>winget install OpenJS.NodeJS.LTS</code>), your distro or your version manager.</p>
            <div class="code"><div>node -v <span class="c"># v20.3.0 or newer</span></div></div></div></li>
          <li><div><h3>Install from npm</h3>
            <div class="code"><div>npm i -g mysticals</div></div></div></li>
          <li><div><h3>Run it</h3>
            <p>Press <code>?</code> for keys. Want a look first? Mock mode gives you two fake isolated accounts and touches nothing real.</p>
            <div class="code"><div>mysticals</div><div>MYSTICALS_MOCK=1 mysticals <span class="c"># macOS, Linux</span></div><div>$env:MYSTICALS_MOCK=1; mysticals <span class="c"># Windows PowerShell</span></div><div>set "MYSTICALS_MOCK=1" &amp;&amp; mysticals <span class="c"># Windows cmd</span></div></div></div></li>
          <li data-only="mac"><div><h3>Allow the Keychain item</h3>
            <p>On first use macOS asks to access the <code>mysticals-terminal</code> Keychain item. Choose Always Allow — it holds the key that encrypts your credentials.</p></div></li>
          <li data-only="windows" hidden><div><h3>Nothing to allow</h3>
            <p>The key that encrypts your credentials is sealed with Windows DPAPI for your user, in <code>master.key</code> in the data folder. Use Windows Terminal for the best mouse and colour support.</p></div></li>
          <li data-only="linux" hidden><div><h3>Have a keyring and secret-tool</h3>
            <p>The key that encrypts your credentials goes into the Secret Service (GNOME Keyring, KWallet) through <code>secret-tool</code>. Notifications use <code>notify-send</code>.</p>
            <div class="code"><div>sudo apt install libsecret-tools <span class="c"># Fedora/Arch: libsecret</span></div></div></div></li>
          <li><div><h3>Add accounts with s</h3>
            <p>Press <code>s</code> → add Google or CalDAV. To update later, run <code>npm i -g mysticals</code> again — the status line tells you when.</p></div></li>
        </ol>
        <div class="keys">
          <h3>Keys</h3>
          <div class="table" style="--cols: 2">
            <div><span>key</span><span>action</span></div>
            {keys.map(([ks, what]) => <div><span>{ks.map((k) => <kbd>{k}</kbd>)}</span><span class="muted">{what}</span></div>)}
          </div>
          <p class="muted">Mouse works too: click to select, click again to open, the wheel scrolls.</p>
        </div>
      </div>
    </div>

    <aside>
      <div class="side">
        <span class="eyebrow">requirements</span>
        <div><span class="muted">System</span><span>macOS, Windows, Linux</span></div>
        <div><span class="muted">Chips</span><span>Apple Silicon, Intel · x64 on Windows/Linux</span></div>
        <div><span class="muted">Terminal app</span><span>Node.js 20.3+</span></div>
      </div>
      <div class="side">
        <span class="eyebrow">where data lives</span>
        <span class="muted">Terminal: <code class="path">mysticals-terminal</code> in <code class="path">~/Library/Application Support</code> (macOS), <code class="path">%APPDATA%</code> (Windows) or <code class="path">~/.local/share</code> (Linux)</span>
        <span class="muted">Credentials are encrypted per account. The desktop and terminal apps never share data.</span>
      </div>
    </aside>
  </section>

  <section class="wrap block">
    <div class="head">
      <h2>Connect your calendars</h2>
      <p class="muted">Same steps in both apps. For CalDAV, use an app password — you need one when 2FA is on, and it’s a good idea anyway.</p>
    </div>
    <div class="table">
      <div><span>provider</span><span>server</span><span>password</span></div>
      <div><b>Google</b><span class="muted">Sign in with Google in the browser</span><span class="muted">None — OAuth</span></div>
      <div><b>Namecheap Private Email</b><code>dav.privateemail.com/dav.php/</code><span class="muted">App password from Private Email webmail</span></div>
      <div><b>iCloud</b><code>caldav.icloud.com</code><span class="muted">App-specific password from appleid.apple.com</span></div>
      <div><b>Fastmail</b><code>caldav.fastmail.com</code><span class="muted">Settings → Privacy &amp; Security → App passwords</span></div>
      <div><b>Any CalDAV server</b><span class="muted">Choose Custom and paste its URL</span><span class="muted">Whatever your server issues</span></div>
    </div>
    <p class="muted small">Username is your full email address. Presets fill in the server URL for you.</p>
  </section>

  <section class="wrap block last">
    <h2>Troubleshooting</h2>
    <div class="grid3">
      <div class="fact"><b>“Can’t be opened” on launch</b><span>The desktop app isn’t notarized. macOS: “Open Anyway” in System Settings → Privacy &amp; Security, or <code>xattr -dr com.apple.quarantine /Applications/Mysticals.app</code>. Windows: More info → Run anyway.</span></div>
      <div class="fact"><b>macOS: Keychain prompt after an update</b><span>Every build has its own signature, so after an update macOS asks once to access “Mysticals Safe Storage”. Choose Always Allow: it holds the key to your saved accounts. If you deny it, the accounts have to be added again.</span></div>
      <div class="fact"><b>Linux: “Secure storage is unavailable”</b><span>No Secret Service keyring is running. Install and unlock GNOME Keyring or KWallet (and <code>libsecret-tools</code> for the terminal app).</span></div>
      <div class="fact"><b>Terminal daemon won’t start</b><span>Read <code>daemon.log</code> in the data folder. Stuck? Close every window, then <code>pkill -f 'cli.js --daemon'</code> (Windows: end the Node.js process in Task Manager).</span></div>
      <div class="fact"><b>Can’t select text in the TUI</b><span>Hold ⌥ Option while dragging on macOS, Shift in most Linux and Windows terminals. In tmux, set <code>mouse on</code> to pass clicks through.</span></div>
    </div>
  </section>
</Layout>

<script>
  // Show the steps for the picked app and system. #terminal in the URL preselects the terminal app.
  const s = { app: location.hash === '#terminal' ? 'terminal' : 'desktop', os: 'mac' }
  function show() {
    for (const b of document.querySelectorAll<HTMLElement>('[data-app]')) b.setAttribute('aria-pressed', String(b.dataset.app === s.app))
    for (const b of document.querySelectorAll<HTMLElement>('[data-os]')) b.setAttribute('aria-pressed', String(b.dataset.os === s.os))
    const want = s.app === 'desktop' ? `desktop-${s.os}` : 'terminal'
    for (const p of document.querySelectorAll<HTMLElement>('[data-panel]')) p.hidden = p.dataset.panel !== want
    for (const e of document.querySelectorAll<HTMLElement>('[data-only]')) e.hidden = e.dataset.only !== s.os
  }
  document.querySelectorAll<HTMLElement>('[data-app], [data-os]').forEach((b) =>
    b.addEventListener('click', () => {
      if (b.dataset.app) s.app = b.dataset.app
      if (b.dataset.os) s.os = b.dataset.os
      show()
    }),
  )
  show()
</script>

<style>
  .pickers { padding-bottom: 56px; display: flex; flex-wrap: wrap; gap: 24px 48px; }
  .picker { display: flex; align-items: center; gap: 16px; }
  .picker .eyebrow { font-size: 13px; }
  .seg { display: flex; gap: 4px; padding: 4px; border: 1px solid var(--line-strong); border-radius: 10px; }
  .seg button { min-height: 44px; padding: 0 clamp(12px, 1.6vw, 20px); border: 0; border-radius: 7px; background: transparent; color: var(--muted); font: 15px var(--mono); cursor: pointer; }
  .seg button:hover { color: var(--fg); }
  .seg button[aria-pressed='true'] { background: var(--fg); color: var(--bg); font-weight: 600; }

  .guide { display: grid; gap: 40px 24px; }
  @media (min-width: 1000px) {
    .guide { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .panels { grid-column: span 8; }
    aside { grid-column: 10 / span 3; }
  }
  .panels, aside { min-width: 0; }
  aside { display: flex; flex-direction: column; gap: 20px; }
  .side { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 24px; display: flex; flex-direction: column; gap: 14px; font-size: 14px; line-height: 1.55; }
  .side .eyebrow { font-size: 13px; }
  .side > div { display: flex; justify-content: space-between; gap: 12px; }
  .path { word-break: break-all; }
  .steps code { color: var(--soft); }
  /* global .steps > li sets display: flex, which would beat the hidden attribute */
  .steps > li[hidden] { display: none; }

  .keys { margin-top: 56px; display: flex; flex-direction: column; gap: 20px; }
  .keys .table > div:not(:first-child) { padding-block: 12px; }
  @media (max-width: 720px) { .keys .table > div { grid-template-columns: auto 1fr; } }
  .keys kbd { margin-right: 4px; }
  .keys > p { font-size: 14px; }

  .block { padding-top: clamp(72px, 8vw, 104px); display: flex; flex-direction: column; gap: 32px; }
  .block h2 { font-size: 36px; letter-spacing: -.035em; }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .head p { font-size: 17px; }
  .table code { font-size: 14px; overflow-wrap: anywhere; }
  .small { font-size: 14px; }
  .last { padding-bottom: clamp(72px, 9vw, 120px); }
</style>
