  .seg { display: flex; gap: 4px; padding: 4px; border: 1px solid var(--line-strong); border-radius: 10px; }
  .seg button { min-height: 44px; padding: 0 clamp(12px, 1.6vw, 20px); border: 0; border-radius: 7px; background: transparent; color: var(--muted); font: 15px var(--mono); cursor: pointer; }
  .seg button:hover { color: var(--fg); }
  .seg button[aria-pressed='true'] { background: var(--fg); color: var(--bg); font-weight: 600; }

  .guide { display: grid; gap: 40px 24px; }
  @media (min-width: 1000px) {
    .guide { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .panels { grid-column: span 8; }
    aside { grid-column: 10 / span 3; }
  }
  .panels, aside { min-width: 0; }
  aside { display: flex; flex-direction: column; gap: 20px; }
  .side { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 24px; display: flex; flex-direction: column; gap: 14px; font-size: 14px; line-height: 1.55; }
  .side .eyebrow { font-size: 13px; }
  .side > div { display: flex; justify-content: space-between; gap: 12px; }
  .side :global(.path) { word-break: break-all; } /* inside set:html text, so no scoped attribute */
  .steps code { color: var(--soft); }
  /* global .steps > li sets display: flex, which would beat the hidden attribute */
  .steps > li[hidden] { display: none; }

  .keys { margin-top: 40px; display: flex; flex-direction: column; gap: 20px; }
  .keys .table > div:not(:first-child) { padding-block: 12px; }
  @media (max-width: 720px) { .keys .table > div { grid-template-columns: auto 1fr; } }
  .keys kbd { margin-right: 4px; }
  .keys > p { font-size: 14px; }

  .block { padding-top: clamp(48px, 5vw, 72px); display: flex; flex-direction: column; gap: 32px; }
  .block h2 { font-size: 32px; letter-spacing: -.035em; }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .head p { font-size: 17px; }
  .table code { font-size: 14px; overflow-wrap: anywhere; }
  .small { font-size: 14px; }
  .last { padding-bottom: clamp(48px, 6vw, 80px); }
</style>
