---
import Layout from '../layouts/Layout.astro'
import OsIcon from '../components/OsIcon.astro'
import desktop from '../../../desktop/package.json'
import terminal from '../../../terminal/package.json'
const gh = 'https://github.com/a1exalexander/mysticals'
// Installer names carry no version (electron-builder.yml), so GitHub redirects to the file on the newest release.
const dl = (name: string) => `${gh}/releases/latest/download/${name}`
const v = desktop.version
---
<Layout title="Download Mysticals" description="Download the Mysticals desktop app for macOS, Windows or Linux, or install the terminal app from npm.">
  <section class="wrap page-head">
    <span class="eyebrow">$ mysticals --version → {v}</span>
    <h1>Download Mysticals</h1>
    <p class="lead">Two apps, one idea. Both are free, both run on macOS, Windows and Linux, and they keep separate accounts — install one or both.</p>
  </section>

  <section class="wrap grid2">
    <article class="card">
      <div class="card-head">
        <div>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" /></svg>
          <h2>Desktop app</h2>
        </div>
        <span class="tag">v{v}</span>
      </div>
      <p class="muted">Pick your system. The button for this computer is highlighted.</p>
      <div class="os-group">
        <h3><OsIcon os="macos" size={18} />macOS</h3>
        <div class="picks">
          <a class="pick btn" data-pick="mac-arm64" href={dl('Mysticals-arm64.dmg')} data-track="download_click" data-props='{"os":"macos","arch":"arm64","format":"dmg"}'>
            <OsIcon os="macos" /><span><b>Apple Silicon <em class="rec">For this computer</em></b><small>Macs with an Apple M chip: M1 and newer, late 2020 onward</small><small class="mono file">Mysticals-arm64.dmg</small></span><svg class="arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
          </a>
          <a class="pick ghost" data-pick="mac-x64" href={dl('Mysticals-x64.dmg')} data-track="download_click" data-props='{"os":"macos","arch":"x64","format":"dmg"}'>
            <OsIcon os="macos" /><span><b>Apple Intel <em class="rec">For this computer</em></b><small>Older Macs with an Intel processor</small><small class="mono file">Mysticals-x64.dmg</small></span><svg class="arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
          </a>
        </div>
        <p class="hint">Not sure which Mac you have? Apple menu → About This Mac. “Chip: Apple M…” is Apple Silicon, “Processor: Intel…” is Intel.</p>
      </div>
      <div class="os-group">
        <h3><OsIcon os="windows" size={18} />Windows</h3>
        <div class="picks">
          <a class="pick ghost" data-pick="win-x64" href={dl('Mysticals-x64-setup.exe')} data-track="download_click" data-props='{"os":"windows","arch":"x64","format":"exe"}'>
            <OsIcon os="windows" /><span><b>Windows <em class="rec">For this computer</em></b><small>Windows 10 and 11, 64-bit</small><small class="mono file">Mysticals-x64-setup.exe</small></span><svg class="arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
          </a>
        </div>
      </div>
      <div class="os-group">
        <h3><OsIcon os="linux" size={18} />Linux</h3>
        <div class="picks">
          <div class="pair">
            <a class="pick ghost" data-pick="linux-x64" href={dl('Mysticals-x86_64.AppImage')} data-track="download_click" data-props='{"os":"linux","arch":"x64","format":"appimage"}'>
              <OsIcon os="linux" /><span><b>Linux Intel / AMD <em class="rec">For this computer</em></b><small>Most PCs and laptops (x86_64), any distro</small><small class="mono file">Mysticals-x86_64.AppImage</small></span><svg class="arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
            </a>
            <a class="deb ghost" href={dl('Mysticals-amd64.deb')} data-track="download_click" data-props='{"os":"linux","arch":"x64","format":"deb"}'><b>.deb</b><small>Debian / Ubuntu</small></a>
          </div>
          <div class="pair">
            <a class="pick ghost" data-pick="linux-arm64" href={dl('Mysticals-arm64.AppImage')} data-track="download_click" data-props='{"os":"linux","arch":"arm64","format":"appimage"}'>
              <OsIcon os="linux" /><span><b>Linux ARM <em class="rec">For this computer</em></b><small>Raspberry Pi 4 and 5, ARM laptops and boards (arm64), any distro</small><small class="mono file">Mysticals-arm64.AppImage</small></span><svg class="arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
            </a>
            <a class="deb ghost" href={dl('Mysticals-arm64.deb')} data-track="download_click" data-props='{"os":"linux","arch":"arm64","format":"deb"}'><b>.deb</b><small>Debian / Ubuntu</small></a>
          </div>
        </div>
        <p class="hint">Not sure? Run <code>uname -m</code>: <code>x86_64</code> is Intel / AMD, <code>aarch64</code> is ARM.</p>
      </div>
      <div class="notes">
        <span>The Mac app is signed and notarized by Apple. Windows: if SmartScreen warns about an unknown publisher, click More info → Run anyway. <a class="ul" href="/install/">Step by step →</a></span>
        <span>Everything else, including the Mac <code>.zip</code>: <a class="ul" href={`${gh}/releases/latest`}>latest release →</a></span>
      </div>
    </article>

    <article class="card">
      <div class="card-head">
        <div>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="18" rx="2" /><path d="m6 9 3 3-3 3" /><path d="M12 15h5" /></svg>
          <h2>Terminal app</h2>
        </div>
        <span class="tag">npm · v{terminal.version}</span>
      </div>
      <p class="muted">Installs from npm as a global command. Needs Node.js 20.3 or newer. Works in any terminal: Terminal.app, iTerm2, Ghostty, WezTerm, Windows Terminal, GNOME Terminal, tmux.</p>
      <div class="shell mono">
        <div class="shell-bar">
          <span>zsh</span>
          <button class="copy" type="button" data-copy="npm i -g mysticals" data-track="npm_copy" data-props='{"location":"download"}' aria-label="Copy install command">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
            <span class="lbl">copy</span>
          </button>
        </div>
        <div class="code">
          <div>npm i -g mysticals</div>
          <div>mysticals <span class="c"># press ? for keys</span></div>
        </div>
      </div>
      <div class="notes">
        <span>Try it with two fake accounts first: <code>MYSTICALS_MOCK=1 mysticals</code> · PowerShell: <code>$env:MYSTICALS_MOCK=1; mysticals</code> · cmd: <code>set "MYSTICALS_MOCK=1" &amp;&amp; mysticals</code></span>
        <span>Package page: <a class="ul" href="https://www.npmjs.com/package/mysticals">npmjs.com/package/mysticals</a></span>
      </div>
    </article>
  </section>

  <section class="wrap block">
    <h2>Platforms</h2>
    <div class="table" style="--cols: 4">
      <div><span>system</span><span>desktop</span><span>terminal</span><span>notes</span></div>
      <div><b>macOS · Apple Silicon</b><span class="dot">.dmg arm64</span><span class="dot">npm</span><span class="muted">Recommended</span></div>
      <div><b>macOS · Intel</b><span class="dot">.dmg x64</span><span class="dot">npm</span><span class="muted">Supported</span></div>
      <div><b>Windows · x64</b><span class="dot">.exe setup</span><span class="dot">npm</span><span class="muted">Credentials sealed with DPAPI</span></div>
      <div><b>Linux · x64</b><span class="dot">.AppImage / .deb</span><span class="dot">npm</span><span class="muted">Needs a Secret Service keyring (GNOME Keyring, KWallet)</span></div>
      <div><b>Linux · arm64</b><span class="dot">.AppImage / .deb</span><span class="dot">npm</span><span class="muted">Same keyring requirement as x64</span></div>
    </div>
  </section>

  <section class="wrap grid2 block last">
    <div class="more">
      <h3>Updates</h3>
      <p class="muted">On macOS the desktop app downloads new releases for its architecture and updates itself; on Windows and Linux it tells you and opens the release page. The terminal app checks npm once a day and shows a hint in the status line — then run <code>npm i -g mysticals</code> again.</p>
      <a class="ul" href={`${gh}/releases`}>All releases and changelogs →</a>
    </div>
    <div class="more">
      <h3>Build from source</h3>
      <div class="code">
        <div>git clone {gh}</div>
        <div>cd mysticals</div>
        <div>cp .env.example .env <span class="c"># Google OAuth values, optional</span></div>
        <div>pnpm i</div>
        <div>pnpm dist <span class="c"># desktop installers in apps/desktop/dist</span></div>
        <div>pnpm --filter mysticals build <span class="c"># terminal app in apps/terminal/dist</span></div>
      </div>
      <span class="muted small">Needs Node.js 20.3+ and pnpm 10. Without the Google values only CalDAV accounts work — see <a class="ul" href={`${gh}/blob/main/CONTRIBUTING.md#google-oauth-client-for-google-accounts`}>CONTRIBUTING</a>. Electron binary missing after install? Run <code>node apps/desktop/node_modules/electron/install.js</code>.</span>
    </div>
  </section>
  <script>
    // Highlight the button for this computer. Only the OS is reliable from a browser; Linux ARM also shows up in
    // the user agent or client hints. Macs keep Apple Silicon (Safari reports "Intel" on every Mac).
    const pick = (key: string) => {
      const el = document.querySelector<HTMLElement>(`[data-pick="${key}"]`)
      if (!el) return
      for (const p of document.querySelectorAll<HTMLElement>('[data-pick]')) p.classList.replace('btn', 'ghost')
      el.classList.replace('ghost', 'btn')
      el.classList.add('is-rec')
    }
    const ua = navigator.userAgent
    const hints = (navigator as Navigator & { userAgentData?: { getHighEntropyValues(h: string[]): Promise<{ architecture?: string }> } }).userAgentData
    if (/Windows/.test(ua)) pick('win-x64')
    else if (/Mac OS X|Macintosh/.test(ua) && !/iPhone|iPad/.test(ua)) pick('mac-arm64')
    else if (/Linux/.test(ua) && !/Android/.test(ua)) {
      pick(/aarch64|arm/i.test(ua) ? 'linux-arm64' : 'linux-x64')
      hints?.getHighEntropyValues(['architecture']).then((h) => { if (h.architecture === 'arm') pick('linux-arm64') }, () => {})
    }
  </script>
</Layout>

<style>
  .card { border-color: var(--line-strong); }
  .os-group { display: flex; flex-direction: column; gap: 12px; }
  .os-group h3 { display: flex; align-items: center; gap: 10px; font: 13px var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .picks { display: flex; flex-direction: column; gap: 10px; }
  .pick { min-height: 84px; padding: 14px 22px; border-radius: 12px; gap: 18px; }
  .pick > span { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pick .os-icon { flex: none; }
  .pick .arrow { flex: none; }
  .pick b { font-weight: 600; font-size: 17px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; }
  .pick small { font-size: 14px; font-weight: 400; color: var(--muted); overflow-wrap: anywhere; }
  .pick .file { font-size: 12.5px; color: var(--muted); opacity: .7; }
  .btn.pick small { color: #55556a; }
  .btn.pick .file { color: #55556a; }
  .rec { display: none; font: 11.5px var(--mono); font-style: normal; font-weight: 400; padding: 2px 8px; border-radius: 99px; border: 1px solid currentColor; opacity: .7; }
  .is-rec .rec { display: inline-block; }
  .pair { display: grid; grid-template-columns: 1fr auto; gap: 10px; }
  .deb { min-height: 84px; border-radius: 12px; padding: 0 18px; flex-direction: column; justify-content: center; gap: 0; }
  .deb b { font-weight: 600; font-family: var(--mono); }
  .deb small { font-size: 12.5px; color: var(--muted); }
  .hint { font-size: 14px; color: var(--muted); }
  @media (max-width: 520px) {
    .pick { padding: 14px 16px; gap: 14px; }
    .pair { grid-template-columns: 1fr; }
    .deb { min-height: 52px; flex-direction: row; gap: 10px; }
  }
  .notes { padding-top: 20px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: var(--muted); }
  .notes a, .more a { color: var(--fg); }
  .shell { border: 1px solid var(--line-strong); border-radius: 12px; background: var(--bg); overflow: hidden; }
  .shell-bar { height: 40px; padding: 0 8px 0 18px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }
  .shell .code { border: 0; border-radius: 0; background: none; padding: 20px 18px; font-size: 16px; gap: 10px; }
  .block { padding-top: clamp(64px, 7vw, 96px); display: flex; flex-direction: column; gap: 32px; }
  .block h2 { font-size: 32px; letter-spacing: -.035em; }
  .last { display: grid; padding-bottom: clamp(72px, 9vw, 120px); }
  .more { border-top: 1px solid var(--line); padding-top: 28px; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .more p { line-height: 1.65; }
  .more a { font-size: 15px; }
  .small { font-size: 14px; }
  .hi { color: var(--fg); }
</style>
