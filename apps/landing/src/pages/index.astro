---
import Layout from '../layouts/Layout.astro'
import TermDemo from '../components/TermDemo.astro'
import DesktopDemo from '../components/DesktopDemo.astro'
import desktop from '../../../desktop/package.json'
const rules: [string, string][] = [
  ['No default account', 'Every new event asks which account and calendar it belongs to.'],
  ['No copying across accounts', 'Events are never copied, moved or re-created in another account.'],
  ['RSVPs from the right address', 'Replies go out only through the account that received the invite.'],
  ['You are the organizer', 'Attendees are never added for you. The organizer is always the account you picked.'],
]
const boxes = [
  { name: 'personal', who: 'me@gmail.com · Google', c: 'var(--personal)' },
  { name: 'work', who: 'me@company.com · CalDAV', c: 'var(--work)' },
]
---
<Layout title="Mysticals — all your calendars, none of them mixed up">
  <section class="wrap hero">
    <div class="intro">
      <p class="eyebrow dot">v{desktop.version} · macOS · Windows · Linux · free &amp; open source</p>
      <h1>All your calendars.<br />None of them mixed&nbsp;up.<span class="cursor" aria-hidden="true">_</span></h1>
      <p class="lead">A calendar for several Google and CalDAV accounts — on the desktop or right in your terminal. Every account lives in its own box: its own credentials, sync and cache. Nothing ever crosses between them.</p>
      <div class="row">
        <a class="btn big" href="/download/">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
          Download
        </a>
        <button class="ghost big mono" type="button" data-copy="npm i -g mysticals" data-track="npm_copy" data-props='{"location":"hero"}' aria-label="Copy npm i -g mysticals">
          <span class="muted">$</span><span class="lbl">npm i -g mysticals</span>
        </button>
      </div>
      <p class="providers">Google <i>/</i> Private Email <i>/</i> iCloud <i>/</i> Fastmail <i>/</i> any CalDAV</p>
    </div>
    <div class="stage">
      <div class="desk"><DesktopDemo /></div>
      <div class="term"><TermDemo /></div>
    </div>
  </section>

  <section id="isolation" class="wrap band">
    <div class="split end">
      <div class="stack">
        <span class="eyebrow">01 — isolation</span>
        <h2>Two accounts.<br />A gap nothing crosses.</h2>
      </div>
      <p class="lead">In a shared calendar app, one broken account can quietly make another one the organizer — and your coworkers start getting work invites from your personal address. Mysticals is built so that can't happen.</p>
    </div>
    <div class="split">
      <div class="boxes mono">
        {boxes.map((b) => (
          <div class="box" style={`--c: ${b.c}`}>
            <b><i />{b.name}</b>
            <span class="muted">{b.who}</span>
            <ul>{['credentials', 'sync loop', 'cache', 'RSVPs'].map((x) => <li>▸ own {x}</li>)}</ul>
            <div class="fill" />
          </div>
        ))}
      </div>
      <ol class="rules">
        {rules.map(([t, d], i) => (
          <li><span class="mono muted">{String(i + 1).padStart(2, '0')}</span><div><b>{t}</b><span>{d}</span></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section id="apps" class="wrap band">
    <div class="stack narrow">
      <span class="eyebrow">02 — two apps</span>
      <h2>One calendar. Pick your window.</h2>
      <p class="lead">The desktop and terminal apps are separate, each with its own accounts, settings and credential key. Run both on the same machine with different accounts if you like.</p>
    </div>
    <div class="grid2">
      <article class="card">
        <div class="card-head">
          <div>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" /></svg>
            <h3>Desktop</h3>
          </div>
          <span class="tag">macOS · Windows · Linux</span>
        </div>
        <p class="lead">A desktop window with a mini month, your accounts and invites in a sidebar, and the week at a glance.</p>
        <ul class="plus">
          <li>Day, 2 days, week and month views</li>
          <li>Dark themes: Dracula, Tokyo Night, Catppuccin, Phosphor amber</li>
          <li>Credentials encrypted per account with the system keychain</li>
          <li>Update notices from GitHub Releases (self-updates on macOS)</li>
        </ul>
        <div class="row push">
          <a class="btn" href="/download/">Download</a>
          <a class="ghost" href="/install/">How to install</a>
        </div>
      </article>
      <article class="card">
        <div class="card-head">
          <div>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="18" rx="2" /><path d="m6 9 3 3-3 3" /><path d="M12 15h5" /></svg>
            <h3>Terminal</h3>
          </div>
          <span class="tag">npm · Node 20.3+</span>
        </div>
        <p class="lead">The same calendar as a full-screen TUI. Keyboard first, mouse welcome, and it takes its colours from your terminal theme.</p>
        <ul class="plus">
          <li>Agenda, day, 2 days, week and month views</li>
          <li>Accept, decline or maybe invites with y / n / m</li>
          <li>One background daemon syncs for every open window</li>
          <li>System notifications, 16 ANSI colours, NO_COLOR respected</li>
        </ul>
        <div class="row push">
          <button class="btn mono" type="button" data-copy="npm i -g mysticals" data-track="npm_copy" data-props='{"location":"terminal_card"}' aria-label="Copy npm i -g mysticals"><span class="lbl">npm i -g mysticals</span></button>
          <a class="ghost" href="/install/#terminal">How to install</a>
        </div>
      </article>
    </div>
    <div class="grid3">
      <div class="fact"><b>Never touches Apple Calendar</b><span>Accounts are added inside Mysticals. It never reads the macOS Calendar database.</span></div>
      <div class="fact"><b>CalDAV without the dance</b><span>Presets for Private Email, iCloud and Fastmail. Custom for any other server.</span></div>
      <div class="fact"><b>Open source, MIT</b><span>Read the code, build it yourself, or open an issue on GitHub.</span></div>
    </div>
  </section>

  <section id="why" class="wrap band why">
    <div class="stack">
      <span class="eyebrow">03 — why it exists</span>
      <h2>The invite that should never have been sent.</h2>
    </div>
    <div class="story">
      <p>I have a few personal calendars and a work one on Private Email. That work account only speaks CalDAV, and on a Mac the only practical way to use CalDAV was the built-in Calendar app. I looked for something else and found nothing I enjoyed — Thunderbird can do it, but it was never for me.</p>
      <p>And Calendar worked fine. Until one day the work account dropped off — something outside the Mac broke, not Apple’s fault. But the app kept going, and started sending invites for work meetings to my colleagues from my personal address.</p>
      <p class="hi">That was the boiling point. So I built my own: one calendar for the desktop, one right in the terminal — where every account stays in its own box, and nothing crosses between them.</p>
      <p class="sign"><i />
        <span><a class="hi ul" href="https://www.sashkoratushnyi.com/">Oleksandr Ratushnyi</a> · creator of Mysticals</span>
      </p>
    </div>
  </section>

  <section class="wrap cta-wrap">
    <div class="cta card">
      <div class="stack">
        <h2>Keep work at work.</h2>
        <p class="lead">Free for macOS, Windows and Linux. Desktop or terminal — or both.</p>
      </div>
      <div class="row">
        <a class="btn big" href="/download/">Download</a>
        <a class="ghost big" href="/install/">Install guide</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .stack { display: flex; flex-direction: column; gap: 20px; }
  .big { min-height: 52px; padding-inline: 24px; border-radius: 10px; font-size: 16px; }
  .ghost.big { font-size: 15px; font-weight: 400; }
  .mono { font-family: var(--mono); } /* global .btn/.ghost `font: inherit` otherwise wins */

  /* hero: copy left, demos right — the terminal overlays the desktop's lower right corner */
  .hero { padding-block: clamp(56px, 7vw, 104px) clamp(64px, 8vw, 112px); display: grid; gap: 64px; align-items: start; overflow-x: clip; }
  .intro { display: flex; flex-direction: column; gap: 32px; }
  .providers { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 14px; color: var(--muted); }
  .providers i { font-style: normal; color: var(--faint); }
  .stage { min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  .term :global(.win) { box-shadow: 0 30px 80px -10px rgb(0 0 0 / .95), 0 0 0 8px rgb(11 11 16 / .6); }
  .desk :global(.dwin) { box-shadow: 0 50px 140px -40px rgb(0 0 0 / .95); }
  .term { width: min(480px, 100%); }
  /* Both demos share one grid cell, so the terminal overlays the desktop yet still counts toward the stage height.
     A % margin-top follows the stage width, and both demos scale with width (cqw), so the overlap stays proportional.
     Every 12s the window in front swaps: z-index flips mid-transition while scale and brightness ease. */
  @media (min-width: 760px) {
    .stage { display: grid; }
    .desk, .term { grid-area: 1 / 1; animation: swap 24s ease-in-out infinite both; }
    .desk { margin-right: 8%; animation-delay: -12s; }
    .term { justify-self: end; margin-top: 20%; }
    .term :global(.win) { margin-right: 0; }
  }
  @keyframes swap {
    0%, 46% { z-index: 2; transform: none; filter: none; }
    50%, 96% { z-index: 1; transform: scale(.97); filter: brightness(.7); }
    100% { z-index: 2; transform: none; filter: none; }
  }
  @media (min-width: 1200px) {
    .hero { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .term { margin-top: 26%; }
  }

  .split { display: grid; gap: 48px 64px; }
  .split + .split { margin-top: 64px; }
  @media (min-width: 1000px) { .split { grid-template-columns: repeat(2, minmax(0, 1fr)); } .split.end { align-items: end; } }

  .boxes { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .box { min-height: 400px; border: 1px solid var(--c); border-radius: 12px; padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .box b { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .box b i { width: 10px; height: 10px; border-radius: 2px; background: var(--c); }
  .box > span { font-size: 13px; }
  .box ul { margin: 8px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 13px; color: var(--muted); }
  .box .fill { margin-top: auto; height: 80px; border-radius: 8px; background: color-mix(in srgb, var(--c) 14%, transparent); }

  .rules { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .rules li { padding-block: 22px; border-bottom: 1px solid var(--line); display: flex; gap: 24px; }
  .rules li > span { font-size: 14px; padding-top: 3px; }
  .rules div { display: flex; flex-direction: column; gap: 6px; }
  .rules b { font-size: 18px; font-weight: 600; }
  .rules div span { color: var(--muted); line-height: 1.5; }

  #apps { display: flex; flex-direction: column; gap: 56px; }
  .narrow { max-width: 760px; }
  .narrow .lead, .card .lead { max-width: none; font-size: 17px; }
  .push { margin-top: auto; }

  .why { display: grid; gap: 40px 24px; }
  .why h2 { font-size: clamp(30px, 2.8vw, 40px); }
  .story { display: flex; flex-direction: column; gap: 22px; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.65; color: var(--soft); }
  .hi { color: var(--fg); }
  .sign { margin-top: 12px; display: flex; align-items: center; gap: 14px; font-size: 15px; color: var(--muted); }
  .sign i { width: 40px; height: 1px; background: var(--line-strong); }
  @media (min-width: 1000px) {
    .why { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .why .stack { grid-column: span 4; }
    .story { grid-column: 6 / span 7; }
  }

  .cta-wrap { padding-bottom: clamp(72px, 9vw, 120px); }
  .cta { border-color: var(--line-strong); border-radius: 20px; padding: clamp(32px, 5vw, 72px) clamp(24px, 4.5vw, 64px); flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px 48px; }
  .cta h2 { font-size: clamp(30px, 3vw, 44px); }
  .cta .stack { gap: 16px; }
</style>
