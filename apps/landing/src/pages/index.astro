---
import Layout from '../layouts/Layout.astro'
import TermDemo from '../components/TermDemo.astro'
import DesktopDemo from '../components/DesktopDemo.astro'
const releases = 'https://github.com/a1exalexander/mysticals/releases/latest'
const features: [string, string][] = [
  ['many-accounts', 'Add as many Google and CalDAV accounts as you like. Work, personal, side projects. All in one view.'],
  ['isolated', 'No default account. Every event picks its account and calendar. RSVPs go from the account that got the invite.'],
  ['local', 'No Mysticals account. No sign-up. Your data stays on your device.'],
  ['free', 'Both apps are free. No trials, no plans.'],
]
---
<Layout title="Mysticals — all your calendars, one app">
  <section class="hero">
    <h1>All your calendars. <span class="grad">One app.</span></h1>
    <p class="lead">Connect many Google and CalDAV accounts. See every event in one place. Free, local, no sign-up.</p>
    <div class="pills">
      <span class="pill">Google</span><span class="pill">iCloud</span><span class="pill">Fastmail</span><span class="pill">Any CalDAV</span>
    </div>
  </section>

  <div class="demo">
    <input type="radio" name="demo" id="d-term" checked />
    <input type="radio" name="demo" id="d-desk" />
    <div class="tabs" role="presentation">
      <label for="d-term">terminal</label>
      <label for="d-desk">desktop</label>
    </div>
    <div class="pane p-term"><TermDemo /></div>
    <div class="pane p-desk"><DesktopDemo /></div>
  </div>

  <h2>ls features/</h2>
  <ul class="ls">
    {features.map(([name, text]) => (
      <li><span class="perm">-rw-r--r--</span><b>{name}</b><span>{text}</span></li>
    ))}
  </ul>

  <h2>Two apps. Pick yours.</h2>
  <div class="grid apps">
    <div class="card">
      <h3>desktop</h3>
      <p>A native-feeling calendar app. macOS · Windows · Linux.</p>
      <div class="actions">
        <a class="btn" href={releases}>Download</a>
        <a class="btn ghost" href="/desktop">How to install</a>
      </div>
    </div>
    <div class="card">
      <h3>terminal</h3>
      <p>Your calendars in the terminal. Keyboard and mouse. macOS · Windows · Linux, Node 20+.</p>
      <pre><code><span class="p">$ </span>npm i -g mysticals</code></pre>
      <div class="actions"><a class="btn ghost" href="/terminal">Terminal guide</a></div>
    </div>
  </div>

  <h2>man mysticals</h2>
  <details><summary>Is it free?</summary><p>Yes. Both apps are free.</p></details>
  <details><summary>Do I need an account?</summary><p>No. There is no Mysticals account. You only sign in to your own Google or CalDAV accounts.</p></details>
  <details><summary>Where is my data?</summary><p>On your device. Events and credentials are stored locally. Nothing goes through our servers.</p></details>
</Layout>

<style>
  .hero h1 { margin-top: 56px; }
  .pills { margin-top: 16px; }
  .demo { margin-top: 40px; }
  .demo input { position: absolute; opacity: 0; pointer-events: none; }
  .tabs { display: flex; justify-content: center; gap: 2px; }
  .tabs label { cursor: pointer; padding: 4px 14px; color: var(--muted); border: 1px solid var(--line-strong); border-bottom: 0; }
  .tabs label::before { content: './'; color: var(--line-strong); }
  #d-term:checked ~ .tabs [for='d-term'], #d-desk:checked ~ .tabs [for='d-desk'] { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  #d-term:checked ~ .tabs [for='d-term']::before, #d-desk:checked ~ .tabs [for='d-desk']::before { color: var(--bg); }
  .demo input:focus-visible ~ .tabs label { outline-offset: 2px; }
  #d-term:focus-visible ~ .tabs [for='d-term'], #d-desk:focus-visible ~ .tabs [for='d-desk'] { outline: 2px solid var(--cyan); }
  .pane { display: none; }
  #d-term:checked ~ .p-term, #d-desk:checked ~ .p-desk { display: block; }

  .ls { list-style: none; padding: 0; margin: 0; }
  .ls li { display: grid; grid-template-columns: auto 14ch 1fr; gap: 0 2ch; padding: 6px 0; border-bottom: 1px dashed var(--line); }
  .ls .perm { color: var(--muted); }
  .ls b { color: var(--cyan); font-weight: 400; }
  .ls li span:last-child { color: var(--muted); }
  @media (max-width: 640px) {
    .ls li { grid-template-columns: 1fr; }
    .ls .perm { display: none; }
  }
  .apps .card { display: flex; flex-direction: column; gap: 14px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; }
  .apps pre { margin: 0; }
</style>
