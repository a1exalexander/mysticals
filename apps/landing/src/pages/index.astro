---
import Layout from '../layouts/Layout.astro'
import TermDemo from '../components/TermDemo.astro'
import DesktopDemo from '../components/DesktopDemo.astro'
const releases = 'https://github.com/a1exalexander/mysticals/releases/latest'
const benefits: [string, string][] = [
  ['Every account, one view', 'Add as many Google and CalDAV accounts as you like. Work, personal, family. Their events show up side by side in one calendar.'],
  ['Never the wrong account', 'There is no default account. Each new event asks which account and calendar it belongs to, and invite replies go from the account that got the invite.'],
  ['Private and free', 'No Mysticals account, no sign-up, no servers of ours. Events and encrypted credentials stay on your device. Both apps are free.'],
]
---
<Layout title="Mysticals — all your calendars in one place">
  <section class="hero">
    <h1>All your calendars in one place</h1>
    <p class="lead">Connect every Google and CalDAV account you have and see them together. Free, no sign-up, and your data stays on your device.</p>
    <div class="cta">
      <a class="btn" href={releases}>Download for desktop</a>
      <code class="npm"><span class="p">$</span>npm i -g mysticals</code>
    </div>
    <p class="works muted">Works with Google, iCloud, Fastmail and any CalDAV server.</p>
  </section>

  <div class="stage">
    <figure class="app">
      <DesktopDemo />
      <figcaption>
        <div><h3>Desktop app</h3><p class="muted">macOS, Windows and Linux.</p></div>
        <a href="/desktop">Install guide</a>
      </figcaption>
    </figure>
    <figure class="app">
      <TermDemo />
      <figcaption>
        <div><h3>Terminal app</h3><p class="muted">Keyboard first, mouse works too. Node 20+.</p></div>
        <a href="/terminal">Terminal guide</a>
      </figcaption>
    </figure>
  </div>

  <h2>Why Mysticals</h2>
  <div class="cards">
    {benefits.map(([title, text]) => <div class="card"><h3>{title}</h3><p>{text}</p></div>)}
  </div>

  <h2>Questions</h2>
  <details><summary>Is it free?</summary><p>Yes. Both apps are free and open source.</p></details>
  <details><summary>Do I need an account?</summary><p>No. There is no Mysticals account. You only sign in to your own Google or CalDAV accounts.</p></details>
  <details><summary>Where is my data?</summary><p>On your device. Events and credentials are stored locally, and credentials are encrypted. Nothing goes through our servers.</p></details>
  <details><summary>Desktop or terminal?</summary><p>Same calendars, two ways to use them. They keep separate settings, so you can run both, even with different accounts.</p></details>
</Layout>

<style>
  .hero { text-align: center; }
  .hero .lead { margin-inline: auto; }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 16px; margin-top: 32px; }
  .npm { display: inline-flex; align-items: center; gap: 1ch; min-height: 44px; padding: 0 16px; border-radius: 10px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); user-select: all; }
  .npm .p { user-select: none; }
  .works { font-size: .95rem; margin-top: 20px; }

  /* wider than the text column so both demos get room */
  .stage { width: min(1360px, 100vw - 32px); margin: 64px 0 0 50%; transform: translateX(-50%); display: grid; gap: 48px 32px; }
  @media (min-width: 1100px) { .stage { grid-template-columns: 1.25fr 1fr; } }
  /* demos differ in height: keep captions on one line */
  .app { margin: 0; min-width: 0; display: flex; flex-direction: column; }
  .app > figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; margin-top: auto; padding-top: 20px; }
  .app > figcaption p { margin: 0; }
</style>
