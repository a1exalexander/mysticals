---
/**
 * Animated illustration of the desktop app, pure CSS on one 16s loop: sync loader, events of three accounts drop
 * into a week grid, a drag creates an event that must pick its account and calendar, an invite gets accepted from
 * the account that received it. Layout follows apps/desktop/src/renderer (Sidebar, TimeGrid, StatusBar).
 * The script only fills dates from the viewer's today and pauses the loop off screen.
 * Base styles are the final frame, so reduced motion (animations off in global.css) shows a still.
 */
type Ev = [off: number, start: number, hours: number, title: string, acc: 'work' | 'pers' | 'icl', extra?: string]
const events: Ev[] = [
  [0, 9.5, 0.25, 'Standup', 'work'],
  [0, 10, 0.75, 'Design review', 'work', 'half1'],
  [0, 10.5, 0.5, 'Dentist', 'pers', 'half2'],
  [0, 14, 1, 'Lunch with Ana', 'icl', 'invite'],
  [1, 11, 1.5, 'Sprint planning', 'work'],
  [2, 8, 1, 'Yoga', 'pers'],
  [2, 15, 0.5, '1:1 with Sam', 'work'],
  [3, 13, 3, 'Hike', 'icl'],
  [-1, 16, 1, 'Retro', 'work'],
  [-1, 8.5, 1, 'Gym', 'pers'],
  [-2, 9, 2, 'Focus', 'work'],
  [-3, 16, 1, 'Dinner', 'icl'],
]
const hours = [8, 9, 10, 11, 12, 13, 14, 15, 16]
const accounts = [
  ['work', 'Work', 'Google', ['Team', 'Product']],
  ['pers', 'Personal', 'Google', ['Health', 'Sport']],
  ['icl', 'iCloud', 'CalDAV', ['Family']],
] as const
---
<figure class="ddemo">
  <div class="dwin" aria-hidden="true">
    <div class="title"><i></i><i></i><i></i><span>Mysticals</span></div>
    <div class="body">
      <aside class="side">
        <div class="mini">
          <div class="mhead"><b class="month-name">Month</b><span>‹ ›</span></div>
          <div class="mgrid">
            {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d) => <span class="dow">{d}</span>)}
            {Array.from({ length: 42 }, () => <span class="md"></span>)}
          </div>
        </div>
        {accounts.map(([id, name, kind, cals]) => (
          <div class="acc">
            <div class="acc-head"><span>▾ {name}</span><small>{kind}</small></div>
            {cals.map((c) => <div class={`cal ${id}`}><i></i>{c}</div>)}
          </div>
        ))}
        <div class="add"><span>+ Google</span><span>+ CalDAV</span></div>
      </aside>
      <section class="main">
        <div class="bar">
          <span class="btn-s">Today</span><span class="dim">‹ ›</span><b class="range">This week</b>
          <span class="seg"><span>Day</span><span>2 Days</span><span class="on">Week</span><span>Month</span></span>
          <span class="btn-s new">+ New</span>
        </div>
        <div class="heads"><span></span>{Array.from({ length: 7 }, () => <span class="dh"></span>)}</div>
        <div class="grid">
          {hours.map((h, i) => <div class="hr" style={`--s:${i}`}>{String(h).padStart(2, '0')}:00</div>)}
          <div class="cols">
            {events.map(([off, s, n, t, acc, extra], i) => (
              <div class={`ev ${acc} ${extra ?? ''}`} data-off={off} style={`--s:${s - 8};--n:${n};--d:${(i % 6) * 0.18}s`}>
                <b>{t}</b>{n >= 0.75 && <small>{`${String(Math.floor(s)).padStart(2, '0')}:${s % 1 ? '30' : '00'}`}</small>}
              </div>
            ))}
            <div class="now" data-off="0"></div>
            <div class="ev work nb" data-off="2" style="--s:2;--n:2">
              <b>Focus time</b><small>10:00 – 12:00</small>
              <svg class="cur c1" viewBox="0 0 12 18"><path d="M1 1v14l4-4 3 6 2-1-3-6h5z" /></svg>
            </div>
            <div class="editor" data-off="2">
              <b>New event</b>
              <label>Account<span class="f"><em class="x1">Pick an account…</em><em class="x2">● Work · Google</em></span></label>
              <label>Calendar<span class="f"><em class="y1">Pick a calendar…</em><em class="y2">Team</em></span></label>
              <span class="save">Save</span>
            </div>
          </div>
        </div>
        <div class="toast">
          <div><b>Lunch with Ana</b><small> · invite to iCloud</small></div>
          <div class="acts"><span class="ok">Accept</span><span>Maybe</span><span>Decline</span></div>
          <div class="done">✓ Accepted · reply sent from iCloud</div>
          <svg class="cur c2" viewBox="0 0 12 18"><path d="M1 1v14l4-4 3 6 2-1-3-6h5z" /></svg>
        </div>
        <div class="loader">
          <div><span class="g">~ $</span> mysticals --sync</div>
          <div class="ll" style="--i:1">✓ Work <span class="dim">Google · 2 calendars</span></div>
          <div class="ll" style="--i:2">✓ Personal <span class="dim">Google · 2 calendars</span></div>
          <div class="ll" style="--i:3">✓ iCloud <span class="dim">CalDAV · 1 calendar</span></div>
          <div class="ll" style="--i:4">loading events…<span class="blk"></span></div>
        </div>
      </section>
    </div>
    <div class="status"><span><b class="g">now</b> Design review</span><span><b class="cy">next</b> Dentist in 10m</span><span class="invc">1 invite</span><span class="sync">● synced</span></div>
  </div>
  <figcaption class="sr-only">Animation: the Mysticals desktop app loading three accounts into one week view, creating an event with an explicit account and calendar, and accepting an invite.</figcaption>
</figure>

<script>
  const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
  for (const fig of document.querySelectorAll<HTMLElement>('.ddemo')) {
    const today = new Date()
    today.setHours(0, 0, 0, 0)
    const mon = (today.getDay() + 6) % 7
    const at = (off: number) => new Date(today.getFullYear(), today.getMonth(), today.getDate() + off)
    fig.querySelectorAll<HTMLElement>('.dh').forEach((el, i) => {
      const d = at(i - mon)
      el.textContent = `${WD[d.getDay()]} ${d.getDate()}`
      el.classList.toggle('today', i === mon)
    })
    fig.querySelectorAll<HTMLElement>('[data-off]').forEach((el) => {
      const c = (mon + Number(el.dataset.off) + 7) % 7
      el.style.setProperty('--c', String(c))
      el.classList.toggle('flip', c > 3)
    })
    const first = new Date(today.getFullYear(), today.getMonth(), 1)
    fig.querySelector('.month-name')!.textContent = first.toLocaleString('en', { month: 'long', year: 'numeric' })
    fig.querySelector('.range')!.textContent = `${at(-mon).toLocaleString('en', { month: 'short', day: 'numeric' })} – ${at(6 - mon).toLocaleString('en', { month: 'short', day: 'numeric' })}`
    fig.querySelectorAll<HTMLElement>('.md').forEach((el, i) => {
      const d = new Date(first.getFullYear(), first.getMonth(), 1 - ((first.getDay() + 6) % 7) + i)
      el.textContent = String(d.getDate())
      el.classList.toggle('other', d.getMonth() !== first.getMonth())
      el.classList.toggle('today', +d === +today)
    })
    new IntersectionObserver(([e]) => fig.classList.toggle('paused', !e.isIntersecting)).observe(fig)
  }
</script>

<style>
  .ddemo { margin: 0; container-type: inline-size; }
  .dwin {
    /* its own dark palette, independent of the page theme */
    --bg: #0b0b10; --surface: #111118; --surface-2: #181822; --line: #1f1f2b; --line-strong: #2d2d3d;
    --fg: #f8f8f2; --muted: #8a93b8; --accent: #bd93f9; --pink: #ff79c6; --green: #50fa7b; --cyan: #8be9fd;
    --yellow: #f1fa8c; --red: #ff5555;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    --work: var(--accent); --pers: var(--green); --icl: var(--cyan); --T: 16s;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: calc(100cqw / 70); line-height: 1.35;
    background: #101017; border: 1px solid var(--line-strong); border-radius: .7em; overflow: hidden;
    color: var(--fg); box-shadow: 0 24px 60px -24px rgb(22 23 29 / .45); user-select: none;
  }
  .ddemo.paused * { animation-play-state: paused !important; }
  .title { display: flex; align-items: center; gap: .45em; padding: .6em .9em; background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .title i { width: .8em; height: .8em; border-radius: 50%; background: var(--red); }
  .title i:nth-child(2) { background: var(--yellow); }
  .title i:nth-child(3) { background: var(--green); }
  .title span { flex: 1; text-align: center; margin-right: 3.5em; color: var(--muted); font-size: .9em; }
  .body { display: flex; }

  .side { width: 13em; flex-shrink: 0; padding: .9em; border-right: 1px solid var(--line); background: var(--surface); font-size: .85em; display: flex; flex-direction: column; gap: 1em; }
  .mhead { display: flex; justify-content: space-between; margin-bottom: .4em; }
  .mhead span, .dow, .other { color: var(--muted); }
  .mgrid { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: .82em; gap: .15em 0; }
  .md.today { background: var(--accent); color: var(--bg); border-radius: 50%; font-weight: 700; }
  .acc-head { display: flex; justify-content: space-between; font-weight: 600; margin-bottom: .2em; }
  .acc-head small { color: var(--muted); font-weight: 400; }
  .cal { display: flex; align-items: center; gap: .5em; padding: .1em .6em; color: var(--muted); }
  .cal i { width: .75em; height: .75em; border-radius: .2em; background: var(--c); }
  .cal.work { --c: var(--work); } .cal.pers { --c: var(--pers); } .cal.icl { --c: var(--icl); }
  .add { margin-top: auto; display: flex; gap: .5em; }
  .add span, .btn-s { white-space: nowrap; border: 1px solid var(--line-strong); border-radius: .4em; padding: .15em .6em; color: var(--fg); }

  .main { position: relative; flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .bar { display: flex; align-items: center; gap: .7em; padding: .6em .9em; border-bottom: 1px solid var(--line); font-size: .9em; }
  .seg { margin-left: auto; display: flex; border: 1px solid var(--line-strong); border-radius: .4em; overflow: hidden; }
  .seg span { padding: .15em .6em; color: var(--muted); }
  .seg .on { background: var(--surface-2); color: var(--fg); }
  .new { background: var(--accent); color: var(--bg); border-color: var(--accent); font-weight: 600; }
  .heads { display: grid; grid-template-columns: 3.4em repeat(7, 1fr); }
  .heads { border-bottom: 1px solid var(--line); font-size: .82em; color: var(--muted); text-align: center; padding: .4em 0; }
  .dh.today { color: var(--accent); font-weight: 700; }
  .grid { position: relative; height: 24em; }
  .hr { position: absolute; left: 0; right: 0; top: calc(var(--s) * 100% / 9); border-top: 1px solid var(--line); font-size: .72em; color: var(--muted); padding-left: .4em; }
  .cols { position: absolute; inset: 0 0 0 3.4em; background: repeating-linear-gradient(90deg, transparent 0 calc(100% / 7 - 1px), var(--line) calc(100% / 7 - 1px) calc(100% / 7)); }

  .ev {
    --w: calc(100% / 7); position: absolute; overflow: hidden;
    left: calc(var(--c, 0) * var(--w) + 2px); width: calc(var(--w) - 5px);
    top: calc(var(--s) * 100% / 9 + 1px); height: calc(var(--n) * 100% / 9 - 2px); min-height: 1.3em;
    padding: .15em .4em; border-radius: .35em; font-size: .78em; color: var(--fg);
    background: color-mix(in srgb, var(--k) 22%, #101017); border-left: .25em solid var(--k);
    animation: ev var(--T) var(--d) infinite both;
  }
  .ev b { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  .ev small { color: var(--muted); }
  .ev.work { --k: var(--work); } .ev.pers { --k: var(--pers); } .ev.icl { --k: var(--icl); }
  .ev.half1 { width: calc(var(--w) / 2 - 3px); }
  .ev.half2 { left: calc(var(--c, 0) * var(--w) + var(--w) / 2); width: calc(var(--w) / 2 - 3px); }
  .ev.invite { animation: ev var(--T) var(--d) infinite both, invite var(--T) var(--d) infinite both; }
  @keyframes ev { 0%, 16% { opacity: 0; transform: translateY(-.6em); } 20%, 96% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes invite {
    0%, 80% { background: transparent; border-left-style: dashed; outline: 1px dashed var(--k); outline-offset: -1px; }
    81%, 100% { background: color-mix(in srgb, var(--k) 22%, #101017); border-left-style: solid; outline: 1px dashed transparent; outline-offset: -1px; }
  }

  .now { position: absolute; left: calc(var(--c, 0) * 100% / 7); width: calc(100% / 7); top: calc(2.33 * 100% / 9); height: 2px; background: var(--red); animation: ev var(--T) infinite both; }
  .now::before { content: ''; position: absolute; left: -4px; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--red); }

  .nb { animation: nb var(--T) infinite both; overflow: visible; }
  .nb b, .nb small { animation: nbtext var(--T) infinite both; }
  @keyframes nb {
    0%, 38% { opacity: 0; height: calc(.25 * 100% / 9); background: transparent; border-left-color: transparent; outline: 1px dashed var(--muted); }
    40% { opacity: 1; height: calc(.25 * 100% / 9); background: transparent; border-left-color: transparent; outline: 1px dashed var(--muted); }
    50%, 66% { opacity: 1; height: calc(2 * 100% / 9 - 2px); background: rgb(189 147 249 / .08); border-left-color: transparent; outline: 1px dashed var(--muted); }
    68%, 96% { opacity: 1; outline-color: transparent; }
    100% { opacity: 0; }
  }
  @keyframes nbtext { 0%, 67% { opacity: 0; } 69%, 100% { opacity: 1; } }

  .cur { position: absolute; width: 1.1em; fill: #fff; stroke: #000; stroke-width: 1; opacity: 0; z-index: 5; filter: drop-shadow(0 1px 2px rgb(0 0 0 / .6)); }
  .c1 { right: -.4em; bottom: -.9em; animation: c1 var(--T) infinite both; }
  @keyframes c1 { 0%, 34% { opacity: 0; transform: translate(6em, 4em); } 36% { opacity: 1; transform: translate(6em, 4em); } 40%, 50% { opacity: 1; transform: none; } 53%, 100% { opacity: 0; } }

  .editor {
    position: absolute; z-index: 4; top: calc(1.5 * 100% / 9); left: calc((var(--c, 0) + 1) * 100% / 7 + .4em); width: 15em;
    padding: .7em .8em; font-size: .78em; background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: .5em;
    box-shadow: 0 1em 2em rgb(0 0 0 / .5); display: flex; flex-direction: column; gap: .45em; opacity: 0;
    animation: ed var(--T) infinite both;
  }
  /* no room on the right: open to the left of the new event */
  .editor.flip { left: auto; right: calc((7 - var(--c, 0)) * 100% / 7 + .4em); }
  .editor label { display: flex; flex-direction: column; color: var(--muted); font-size: .9em; }
  .editor .f { position: relative; height: 1.7em; border: 1px solid var(--line-strong); border-radius: .3em; }
  .editor em { position: absolute; inset: 0; padding: .2em .5em; font-style: normal; color: var(--fg); }
  .editor .x1, .editor .y1 { color: var(--muted); }
  .x2 { color: var(--work) !important; animation: sw var(--T) infinite both; }
  .x1 { animation: sw1 var(--T) infinite both; }
  .y2 { animation: sw2 var(--T) infinite both; }
  .y1 { animation: sw3 var(--T) infinite both; }
  @keyframes sw { 0%, 57% { opacity: 0; } 58%, 100% { opacity: 1; } }
  @keyframes sw1 { 0%, 57% { opacity: 1; } 58%, 100% { opacity: 0; } }
  @keyframes sw2 { 0%, 60% { opacity: 0; } 61%, 100% { opacity: 1; } }
  @keyframes sw3 { 0%, 60% { opacity: 1; } 61%, 100% { opacity: 0; } }
  .save { align-self: flex-end; padding: .15em .8em; border-radius: .3em; background: var(--line-strong); animation: save var(--T) infinite both; }
  @keyframes save { 0%, 63% { background: var(--line-strong); color: var(--fg); } 64%, 100% { background: var(--accent); color: var(--bg); } }
  @keyframes ed { 0%, 52% { opacity: 0; transform: scale(.96); } 54%, 66% { opacity: 1; transform: none; } 68%, 100% { opacity: 0; } }

  .toast {
    position: absolute; right: 1em; bottom: 1em; z-index: 4; width: 19em; padding: .7em .9em; font-size: .85em;
    background: var(--surface-2); border: 1px solid var(--line-strong); border-left: .25em solid var(--icl); border-radius: .5em;
    box-shadow: 0 1em 2em rgb(0 0 0 / .5); opacity: 0; animation: toast var(--T) infinite both;
  }
  .toast small { color: var(--muted); }
  .acts { display: flex; gap: .5em; margin-top: .5em; animation: invc var(--T) infinite both; }
  .acts span { padding: .1em .6em; border: 1px solid var(--line-strong); border-radius: .3em; }
  .ok { animation: ok var(--T) infinite both; }
  .done { position: absolute; left: .9em; bottom: .8em; color: var(--green); opacity: 0; animation: donex var(--T) infinite both; }
  @keyframes toast { 0%, 70% { opacity: 0; transform: translateY(1em); } 72%, 92% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; } }
  @keyframes ok { 0%, 78% { background: transparent; color: var(--fg); } 79%, 100% { background: var(--green); color: var(--bg); border-color: var(--green); } }
  @keyframes donex { 0%, 81% { opacity: 0; } 82%, 100% { opacity: 1; } }
  .c2 { left: 3.2em; bottom: .2em; animation: c2 var(--T) infinite both; }
  @keyframes c2 { 0%, 73% { opacity: 0; transform: translate(-4em, -5em); } 74% { opacity: 1; transform: translate(-4em, -5em); } 78%, 81% { opacity: 1; transform: none; } 83%, 100% { opacity: 0; } }

  .loader {
    position: absolute; inset: 0; z-index: 6; padding: 2em; background: #0b0b10; font-family: var(--mono); font-size: .9em;
    display: flex; flex-direction: column; gap: .3em; opacity: 0; visibility: hidden; animation: loader var(--T) infinite both;
  }
  .ll { animation: ll var(--T) calc(var(--i) * .45s) infinite both; }
  @keyframes ll { 0% { opacity: 0; } 1%, 100% { opacity: 1; } }
  @keyframes loader { 0%, 13% { opacity: 1; visibility: visible; } 16%, 100% { opacity: 0; visibility: hidden; } }
  .blk { display: inline-block; width: .55em; height: 1em; margin-left: .2em; vertical-align: -.15em; background: var(--fg); animation: blink 1s steps(1) infinite; }
  .g { color: var(--green); } .cy { color: var(--cyan); } .dim { color: var(--muted); }
  @keyframes blink { 50% { opacity: 0; } }

  .status { display: flex; gap: 1.4em; padding: .35em .9em; font-size: .78em; background: var(--surface); border-top: 1px solid var(--line); color: var(--fg); }
  .invc { color: var(--yellow); animation: invc var(--T) infinite both; }
  @keyframes invc { 0%, 81% { opacity: 1; } 82%, 100% { opacity: 0; } }
  .sync { margin-left: auto; color: var(--green); }

  @container (max-width: 640px) {
    .dwin { font-size: calc(100cqw / 44); }
    .side { display: none; }
    .seg span:not(.on), .status span:nth-child(2) { display: none; }
  }
</style>
