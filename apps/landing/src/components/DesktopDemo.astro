---
/**
 * Animated illustration of the desktop app, pure CSS on one 24s loop. It opens on the Agenda view (today's list,
 * the live call with its Join button, breaks, the next days and the focus card), then a click on Week switches to
 * the week grid: events of three accounts drop in, a drag creates an event whose editor must pick an account and
 * calendar, and a pending invite is accepted from the status-bar invites popover.
 * Markup and styles mirror apps/desktop/src/renderer (styles/base.css, components/ui/ui.css, views/Agenda.css,
 * EventEditor.css, Invites.css), scaled to em. The palette comes from src/themes.ts (Dracula unless `theme` is set);
 * ThemeShowcase swaps it at runtime. With `followPage` it tracks the page theme instead: Dracula on a dark page,
 * Light on a light one, set by CSS so it holds before the first paint and follows the footer switch.
 * The script only fills dates from the viewer's today and pauses the loop off screen.
 * Base styles are the final frame (the week), so reduced motion (animations off in global.css) shows a still.
 * On /uk/ the UI speaks Ukrainian like the app: labels from packages/core/src/i18n/uk.ts, dates like its date-fns uk.
 */
import { THEMES, themeVars } from '../themes'
import { langOf } from '../i18n'
interface Props { theme?: string; followPage?: boolean }
const th = THEMES.find((x) => x.id === Astro.props.theme) ?? THEMES[0]
const { followPage } = Astro.props
// Same selectors as the page's own light theme in global.css; inline styles would beat them, so these are rules
const light = THEMES.find((x) => x.id === 'light')!
const followCss = followPage
  ? `.dwin[data-follow] { ${themeVars(th)} }
@media (prefers-color-scheme: light) { :root:not([data-theme='dark']) .dwin[data-follow] { ${themeVars(light)} } }
:root[data-theme='light'] .dwin[data-follow] { ${themeVars(light)} }`
  : ''
const lang = langOf(Astro.url)
// English text → Ukrainian; anything missing stays English
const UK: Record<string, string> = {
  Standup: 'Стендап', 'Design review': 'Огляд дизайну', Dentist: 'Стоматолог', 'Lunch with Ana': 'Обід з Аною',
  'Sprint planning': 'Планування спринту', Yoga: 'Йога', '1:1 with Sam': '1:1 із Семом', Hike: 'Похід', Retro: 'Ретро',
  Gym: 'Спортзал', Focus: 'Фокус', Dinner: 'Вечеря', 'Focus time': 'Час для фокусу', Holiday: 'Свято',
  'Room 1': 'Переговорна 1', 'Room 3': 'Переговорна 3', Kyiv: 'Київ', Studio: 'Студія', Carpathians: 'Карпати',
  Work: 'Робота', Team: 'Команда', Product: 'Продукт', Health: 'Здоровʼя', Holidays: 'Свята', 'read-only': 'лише перегляд', Family: 'Сімʼя',
  '＋ Add calendar': '＋ Додати календар', Agenda: 'Розклад', Day: 'День', '3 Days': '3 дні', Week: 'Тиждень', Month: 'Місяць',
  Today: 'Сьогодні', today: 'сьогодні', '+ new': '+ нова', 'all-day': 'весь день',
  '15m · video call': '15 хв · відеодзвінок', '● now': '● зараз', 'in 10m · Clinic': 'за 10 хв · Клініка', 'Break · 3h': 'Перерва · 3 год',
  '1h · Kyiv': '1 год · Київ', '1h 30m · Room 3': '1 год 30 хв · Переговорна 3', '1h · Studio': '1 год · Студія', 'Break · 6h': 'Перерва · 6 год', '30m': '30 хв',
  Join: 'Приєднатися', 'Next 7 days': 'Наступні 7 днів', 'Hide upcoming': 'Сховати наступні',
  'now · ends in 25m': 'зараз · до кінця 25 хв', '45m': '45 хв', calendar: 'календар', where: 'де', people: 'учасники', link: 'посилання',
  '▸ 4 people': '▸ 4 людини', 'Join call': 'Приєднатися', Details: 'Докладніше',
  'until 10:45': 'до 10:45', 'next:': 'далі:', 'in 10m': 'за 10 хв', '1 invite': '1 запрошення', Invitations: 'Запрошення',
  Accept: 'Прийняти', Decline: 'Відхилити', Account: 'Обліковий запис', 'Choose account…': 'Оберіть обліковий запис…',
  Calendar: 'Календар', 'Choose calendar…': 'Оберіть календар…', Starts: 'Початок', Ends: 'Кінець', Repeat: 'Повтор',
  'Does not repeat': 'Не повторюється', 'Choose which account this event belongs to.': 'Оберіть, до якого облікового запису належить подія.',
  'Created in': 'Створюється в', Cancel: 'Скасувати', 'Add Event': 'Додати подію',
  'Animation: the Mysticals desktop app opening on today\'s agenda with a live call to join, then switching to a week of events from three accounts, creating an event with an explicit account and calendar, and accepting an invite from the account that received it.':
    'Анімація: десктопний застосунок Mysticals відкривається на сьогоднішньому розкладі з дзвінком, до якого можна приєднатися, потім перемикається на тиждень з подіями трьох акаунтів, створює подію з явно обраним акаунтом і календарем, а потім приймає запрошення з того акаунта, який його отримав.',
}
const tr = (s: string) => (lang === 'uk' ? UK[s] ?? s : s)
type Ev = [off: number, start: number, hours: number, title: string, acc: 'work' | 'pers' | 'icl', meta?: string, extra?: string]
const events: Ev[] = [
  [0, 9.5, 0.25, 'Standup', 'work'],
  [0, 10, 0.75, 'Design review', 'work', 'Room 3', 'half1'],
  [0, 10.5, 0.5, 'Dentist', 'pers', '', 'half2'],
  [0, 14, 1, 'Lunch with Ana', 'icl', 'Kyiv', 'invite'],
  [1, 11, 1.5, 'Sprint planning', 'work', 'Room 3'],
  [2, 8, 1, 'Yoga', 'pers', 'Studio'],
  [2, 15, 0.5, '1:1 with Sam', 'work'],
  [3, 13, 3, 'Hike', 'icl', 'Carpathians'],
  [-1, 16, 1, 'Retro', 'work', 'Room 1'],
  [-1, 8.5, 1, 'Gym', 'pers'],
  [-2, 9, 2, 'Focus', 'work'],
  [-3, 15, 1.5, 'Dinner', 'icl', 'Kyiv'],
]
const hours = [8, 9, 10, 11, 12, 13, 14, 15, 16]
const hh = (s: number) => `${String(Math.floor(s)).padStart(2, '0')}:${s % 1 ? '30' : '00'}`
// [id, label, email shown under it (none when the label already is the email), calendars]
const accounts = [
  ['work', 'Work', 'me@work.example', [['Team'], ['Product']]],
  ['pers', 'me@gmail.example', '', [['Health'], ['Holidays', 'read-only']]],
  ['icl', 'iCloud', 'me@icloud.example', [['Family']]],
] as const
// Agenda rows: [kind, time, account, title, meta, flags]
type Row = ['ev', string, 'work' | 'pers' | 'icl', string, string, string?] | ['now'] | ['gap', string]
const today: Row[] = [
  ['ev', '09:30', 'work', tr('Standup'), tr('15m · video call'), 'past'],
  ['ev', '10:00', 'work', tr('Design review'), `<span class="live">${tr('● now')}</span> · ${tr('Room 3')}`, 'live sel'],
  ['now'],
  ['ev', '10:30', 'pers', tr('Dentist'), tr('in 10m · Clinic')],
  ['gap', tr('Break · 3h')],
  ['ev', '14:00', 'icl', tr('Lunch with Ana'), tr('1h · Kyiv')],
]
const ahead: Row[][] = [
  [['ev', '11:00', 'work', tr('Sprint planning'), tr('1h 30m · Room 3')]],
  [['ev', '08:00', 'pers', tr('Yoga'), tr('1h · Studio')], ['gap', tr('Break · 6h')], ['ev', '15:00', 'work', tr('1:1 with Sam'), tr('30m')]],
]
const tabs = ['Agenda', 'Day', '3 Days', 'Week', 'Month']
// The segmented control's thumb sits under Agenda, then slides to Week: widths and offsets follow the label lengths
const L = tabs.map((x) => tr(x).length)
const segVars = `--aw: calc(${L[0]}ch + 1.5em); --ww: calc(${L[3]}ch + 1.5em); --wx: calc(.15em + ${L[0] + L[1] + L[2]}ch + 5.4em); --wxn: calc(.15em + ${L[0]}ch + 1.8em)`
const WEEKDAYS = lang === 'uk' ? ['П', 'В', 'С', 'Ч', 'П', 'С', 'Н'] : ['M', 'T', 'W', 'T', 'F', 'S', 'S']
const cursor = '<svg viewBox="0 0 12 18"><path d="M1 1v14l4-4 3 6 2-1-3-6h5z" /></svg>'
const chevron = '<svg viewBox="0 0 10 10"><path d="M3.5 2l3 3-3 3" /></svg>'
---
<figure class="ddemo" data-lang={lang}>
  {followPage && <style is:inline set:html={followCss} />}
  <div class="dwin" aria-hidden="true" data-theme={th.id} data-follow={followPage ? '' : undefined} style={followPage ? undefined : themeVars(th)}>
    <div class="lights"><i></i><i></i><i></i></div>
    <aside class="side">
      <div class="mini">
        <div class="mhead"><b class="month-name">Month</b><span>‹</span><span>›</span></div>
        <div class="mgrid">
          {WEEKDAYS.map((d) => <span class="dow">{d}</span>)}
          {Array.from({ length: 42 }, () => <span class="md"></span>)}
        </div>
      </div>
      <div class="accs">
        {accounts.map(([id, name, email, cals]) => (
          <div class={`acc ${id}`}>
            <div class="acc-head"><span class="arrow" set:html={chevron} /><i></i><b>{tr(name)}</b>{email && <small>{email}</small>}</div>
            {cals.map(([c, ro]) => (
              <div class={`cal${c === 'Holidays' ? ' hol' : ''}`}><span class="ck"></span>{tr(c)}{ro && <small>{tr(ro)}</small>}</div>
            ))}
          </div>
        ))}
      </div>
      <div class="sfoot">
        <span>{tr('＋ Add calendar')}</span>
        <svg class="gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
      </div>
    </aside>
    <section class="main">
      <div class="toolbar">
        <svg class="stoggle" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M5.5 8h1M5.5 11h1" /></svg>
        <div class="ttl">
          <span class="tv tw"><b class="tmonth">Month</b><span class="tsub">2026 · W1</span></span>
          <span class="tv ta"><b>{tr('Today')}</b><span class="tsub adate">Monday, 1 January</span></span>
        </div>
        <div class="seg" style={segVars}>
          <span class="thumb"></span>
          {tabs.map((t) => <span class={`t-${t[0].toLowerCase()}`}>{tr(t)}{t === 'Week' && <span class="cur c0" set:html={cursor} />}</span>)}
        </div>
        <div class="tnav"><span>‹</span><span class="today">{tr('today')}</span><span>›</span></div>
        <span class="new">{tr('+ new')}</span>
      </div>
      <div class="views">
        <div class="wkv">
          <div class="heads">
            <span></span>{Array.from({ length: 7 }, () => <span class="dh"><span class="dw"></span><span class="num"></span></span>)}
          </div>
          <div class="allday">
            <span class="adg">{tr('all-day')}</span>
            <div class="adcells"><div class="ev hol ad" data-off="3"><b>{tr('Holiday')}</b></div></div>
          </div>
          <div class="grid">
            {hours.map((h, i) => <div class="hr" style={`--s:${i}`}><span>{String(h).padStart(2, '0')}:00</span></div>)}
            <span class="nowclk">10:20</span>
            <div class="cols">
              <div class="tcol" data-off="0"></div>
              {events.map(([off, s, n, t, acc, meta, extra], i) => (
                <div class={`ev ${acc} ${extra ?? ''} ${n < 0.75 ? 'short' : ''}`} data-off={off} style={`--s:${s - 8};--n:${n};--d:${(i % 6) * 0.15}s`}>
                  <b>{tr(t)}</b><small>{hh(s)}{meta && n >= 0.75 && ` · ${tr(meta)}`}</small>
                </div>
              ))}
              <div class="nowall"></div>
              <div class="now" data-off="0"></div>
              <div class="ev work nb" data-off="2" style="--s:2;--n:2">
                <b>{tr('Focus time')}</b><small>10:00 · {tr('Team')}</small>
                <span class="dghost">10:00 – 12:00</span>
                <span class="cur c1" set:html={cursor} />
              </div>
            </div>
          </div>
        </div>

        <div class="agv">
          <div class="aglist">
            <ol class="agrows">
              {today.map((r, i) => r[0] === 'now' ? <li class="agnow"><span>10:20</span></li>
                : r[0] === 'gap' ? <li class="aggap">{r[1]}</li>
                : (
                  <li class={`agrow ${r[2]} ${r[5] ?? ''}`} style={`--i:${i}`}>
                    <span class="agt">{r[1]}</span><span class="agbar"></span>
                    <span class="agm"><b>{r[3]}</b><small set:html={r[4]} /></span>
                    {r[5]?.includes('live') && <span class="pill">{tr('Join')}</span>}
                  </li>
                ))}
            </ol>
            <div class="agahead"><span class="chev" set:html={chevron} /><em class="x1">{tr('Next 7 days')}</em><em class="x2">{tr('Hide upcoming')}</em></div>
            <div class="agup">
              {ahead.map((day, d) => (
                <div class="agday">
                  <h3 class="agdh" data-day={d + 1}>Day</h3>
                  <ol class="agrows">
                    {day.map((r) => r[0] === 'gap' ? <li class="aggap">{r[1]}</li> : r[0] === 'ev' && (
                      <li class={`agrow ${r[2]}`}><span class="agt">{r[1]}</span><span class="agbar"></span><span class="agm"><b>{r[3]}</b><small>{r[4]}</small></span></li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          </div>
          <section class="agf">
            <div class="agst">{tr('now · ends in 25m')}</div>
            <b class="agft">{tr('Design review')}</b>
            <div class="agfw">10:00 – 10:45 <span>· {tr('45m')}</span></div>
            <dl>
              <dt>{tr('calendar')}</dt><dd><i></i> {tr('Team')}</dd>
              <dt>{tr('where')}</dt><dd>{tr('Room 3')}</dd>
              <dt>{tr('people')}</dt><dd>{tr('▸ 4 people')}</dd>
              <dt>{tr('link')}</dt><dd class="url">https://meet.example/abc-defg</dd>
            </dl>
            <div class="agacts"><span class="join">{tr('Join call')} <kbd>↵</kbd></span><span class="dbtn det">{tr('Details')}</span></div>
          </section>
        </div>
      </div>
    </section>
    <footer class="status">
      <span class="mode"><span class="sw">{tr('Week')}</span><span class="sa">{tr('Agenda')}</span></span>
      <span class="seg-s rng"><span class="sw range">This week</span><span class="sa aday">Today</span></span>
      <span class="seg-s sev"><i class="sdot">●</i> {tr('Design review')} · {tr('until 10:45')}</span>
      <span class="seg-s nxt"><span class="dim">{tr('next:')}</span> {tr('Dentist')} · {tr('in 10m')}</span>
      <span class="grow"></span>
      <span class="invc">{tr('1 invite')}</span>
    </footer>

    <div class="pop">
      <div class="ptitle">{tr('Invitations')}</div>
      <div class="pitem">
        <b>{tr('Lunch with Ana')}</b>
        <span class="dim pwhen">Today · 14:00 – 15:00</span>
        <span class="pacc"><i></i> iCloud · me@icloud.example</span>
        <div class="acts"><span class="dbtn primary ok">{tr('Accept')}</span><span class="dbtn">{tr('Decline')}</span></div>
      </div>
    </div>
    <span class="cur c2" set:html={cursor} />

    <div class="overlay">
      <div class="sheet">
        <div class="shead"><i></i><b>{tr('Focus time')}</b></div>
        <div class="sgrid">
          <label>{tr('Account')}</label><span class="f"><em class="x1">{tr('Choose account…')}</em><em class="x2"><i class="sw-work"></i>{tr('Work')}<small>me@work.example</small></em></span>
          <label>{tr('Calendar')}</label><span class="f"><em class="y1">{tr('Choose calendar…')}</em><em class="y2"><i class="sw-work"></i>{tr('Team')}</em></span>
          <label>{tr('Starts')}</label><span class="f2"><span class="f fd sday">{tr('Today')}</span><span class="f ft">10:00</span></span>
          <label>{tr('Ends')}</label><span class="f2"><span class="f fd sday">{tr('Today')}</span><span class="f ft">12:00</span></span>
          <label>{tr('Repeat')}</label><span class="f"><em class="plain">{tr('Does not repeat')}</em></span>
        </div>
        <div class="ident"><em class="x1">{tr('Choose which account this event belongs to.')}</em><em class="x2">{tr('Created in')} <b>{tr('Work')}</b> · me@work.example</em></div>
        <div class="sacts"><span class="dbtn">{tr('Cancel')}</span><span class="dbtn add">{tr('Add Event')}</span></div>
      </div>
    </div>
  </div>
  <figcaption class="sr-only">{tr("Animation: the Mysticals desktop app opening on today's agenda with a live call to join, then switching to a week of events from three accounts, creating an event with an explicit account and calendar, and accepting an invite from the account that received it.")}</figcaption>
</figure>

<script>
  const cap = (s: string) => s[0].toUpperCase() + s.slice(1)
  for (const fig of document.querySelectorAll<HTMLElement>('.ddemo')) {
    const uk = fig.dataset.lang === 'uk'
    const loc = uk ? 'uk' : 'en'
    const WD = uk ? ['нд', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'] : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
    const short = (d: Date) => d.toLocaleString(loc, { month: 'short' })
    const long = (d: Date) => d.toLocaleString(loc, { month: 'long' })
    /** "Tue 6 Oct 2026" / "вт 6 жовт. 2026", like the app's status-bar range */
    const dayLabel = (d: Date) => `${WD[d.getDay()]} ${d.getDate()} ${short(d)} ${d.getFullYear()}`
    /** "Tue, 6 Oct" / "вт, 6 жовт.", like the agenda day heads and the invites popover */
    const dayShort = (d: Date) => `${WD[d.getDay()]}, ${d.getDate()} ${short(d)}`
    const today = new Date()
    today.setHours(0, 0, 0, 0)
    const mon = (today.getDay() + 6) % 7
    const at = (off: number) => new Date(today.getFullYear(), today.getMonth(), today.getDate() + off)
    fig.querySelectorAll<HTMLElement>('.dh').forEach((el, i) => {
      const d = at(i - mon)
      el.querySelector('.dw')!.textContent = WD[d.getDay()]
      el.querySelector('.num')!.textContent = String(d.getDate())
      el.classList.toggle('today', i === mon)
    })
    fig.querySelectorAll<HTMLElement>('[data-off]').forEach((el) => {
      const off = Number(el.dataset.off)
      const c = (mon + off + 7) % 7
      el.style.setProperty('--c', String(c))
      el.classList.toggle('past', off < 0 && c < mon)
    })
    const first = new Date(today.getFullYear(), today.getMonth(), 1)
    fig.querySelector('.month-name')!.textContent = `${long(first)} ${first.getFullYear()}`
    fig.querySelectorAll<HTMLElement>('.md').forEach((el, i) => {
      const d = new Date(first.getFullYear(), first.getMonth(), 1 - ((first.getDay() + 6) % 7) + i)
      el.textContent = String(d.getDate())
      el.classList.toggle('other', d.getMonth() !== first.getMonth())
      el.classList.toggle('today', +d === +today)
    })
    // Toolbar "September 2026 · W39" (ISO week) and status-bar range "21 – 27 Sep 2026"
    const thu = at(3 - mon)
    const jan4 = new Date(thu.getFullYear(), 0, 4)
    const week = 1 + Math.round(((+thu - +jan4) / 864e5 - 3 + ((jan4.getDay() + 6) % 7)) / 7)
    fig.querySelector('.tmonth')!.textContent = cap(long(today))
    fig.querySelector('.tw .tsub')!.textContent = `${today.getFullYear()} · ${uk ? 'Т' : 'W'}${week}`
    const a = at(-mon), b = at(6 - mon)
    fig.querySelector('.range')!.textContent =
      a.getMonth() === b.getMonth() ? `${a.getDate()} – ${b.getDate()} ${short(b)} ${b.getFullYear()}` : `${a.getDate()} ${short(a)} – ${b.getDate()} ${short(b)} ${b.getFullYear()}`
    // Agenda: "Today · Tuesday, 6 October", day heads for the next days, today's date in the status bar
    fig.querySelector('.adate')!.textContent = cap(today.toLocaleString(loc, { weekday: 'long', day: 'numeric', month: 'long' }))
    fig.querySelector('.aday')!.textContent = dayLabel(today)
    fig.querySelectorAll<HTMLElement>('.agdh').forEach((el) => (el.textContent = dayShort(at(Number(el.dataset.day)))))
    fig.querySelector('.pwhen')!.textContent = `${dayShort(today)} · 14:00 – 15:00`
    const focus = at(2)
    fig.querySelectorAll('.sday').forEach((el) => (el.textContent = `${dayShort(focus)} ${focus.getFullYear()}`))
    new IntersectionObserver(([e]) => fig.classList.toggle('paused', !e.isIntersecting)).observe(fig)
  }
</script>

<style>
  .ddemo { margin: 0; container-type: inline-size; }
  /* Ukrainian labels run longer: room for the Join pill */
  .ddemo[data-lang='uk'] { --pill-room: 8.6em; }
  /* Palette tokens are set inline from src/themes.ts (mirrors the app's base.css); the page theme never leaks in */
  .dwin {
    --mono: ui-monospace, 'SF Mono', Menlo, monospace;
    /* Account colours are the user's own, so they stay the same in every theme */
    --work: #bd93f9; --pers: #50fa7b; --icl: #8be9fd; --hol: #f1fa8c; --T: 24s;
    position: relative; display: grid; grid-template-columns: 14em minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif; font-size: calc(100cqw / 72); line-height: 1.35;
    background: var(--bg); color: var(--fg); border: 1px solid var(--line-strong); border-radius: .8em; overflow: hidden;
    box-shadow: 0 24px 60px -24px rgb(22 23 29 / .45); user-select: none; -webkit-font-smoothing: antialiased;
  }
  .dwin, .dwin :is(.side, .status, .pop, .sheet, .f, .ev, .hr span, .agf, .agv) { transition: background-color .4s ease, color .4s ease, border-color .4s ease; }
  /* Matrix: mono everywhere plus a barely-there phosphor glow, like the app */
  .dwin[data-theme='matrix'] { font-family: var(--mono); text-shadow: 0 0 .15em color-mix(in srgb, var(--accent) 10%, transparent); }
  .ddemo.paused * { animation-play-state: paused !important; }
  .dim { color: var(--muted); }
  .dwin svg { display: block; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* macOS traffic lights over the sidebar (hidden title bar) */
  .lights { position: absolute; top: 1.1em; left: 1.1em; display: flex; gap: .6em; z-index: 2; }
  .lights i { width: .95em; height: .95em; border-radius: 50%; background: var(--red); }
  .lights i:nth-child(2) { background: #f1c84b; }
  .lights i:nth-child(3) { background: #3fc55a; }

  /* ---------- sidebar ---------- */
  .side { display: flex; flex-direction: column; min-width: 0; padding-top: 3.4em; background: var(--surface); border-right: 1px solid var(--line); }
  .mini { padding: .3em 1em 1em; }
  .mhead { display: flex; gap: .8em; align-items: center; padding: 0 0 .6em .3em; font: 600 .82em/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .mhead b { flex: 1; font-weight: 600; }
  .mhead span { color: var(--muted); }
  .mgrid { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: .15em; text-align: center; font: .82em/1.9 var(--mono); }
  .mgrid .dow { font-size: .9em; color: var(--muted); }
  .md { border-radius: .3em; }
  .md.other { color: var(--faint); }
  .md.today { background: var(--pink); color: var(--on-accent); font-weight: 700; }
  .accs { flex: 1; display: flex; flex-direction: column; gap: 1.1em; padding: 1em .75em; border-top: 1px solid var(--line); }
  .acc-head { display: grid; grid-template-columns: .75em .55em 1fr; column-gap: .55em; align-items: center; padding: .3em .45em; }
  .arrow { color: var(--muted); transform: rotate(90deg); }
  .arrow :global(svg) { width: .75em; height: .75em; stroke-width: 1.6; }
  .acc-head i { width: .55em; height: .55em; border-radius: .15em; background: var(--k); }
  .acc-head b { font: 600 .8em/1.4 var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .1em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acc-head small { grid-column: 3; font: .8em/1.5 var(--mono); color: color-mix(in srgb, var(--muted) 70%, var(--fg)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acc.work { --k: var(--work); } .acc.pers { --k: var(--pers); } .acc.icl { --k: var(--icl); }
  .cal { display: flex; align-items: center; gap: .6em; height: 2em; padding: 0 .45em; }
  .cal small { margin-left: auto; font: .75em/1 var(--mono); color: var(--muted); }
  /* .mc-check: a filled square in the calendar colour with a CSS-drawn tick */
  .ck { position: relative; width: 1em; height: 1em; flex: none; border-radius: .23em; background: var(--k); }
  .ck::after { content: ''; position: absolute; left: .26em; top: .24em; width: .5em; height: .28em; border: solid var(--on-accent); border-width: 0 0 .13em .13em; transform: rotate(-45deg); }
  .cal.hol .ck { background: var(--hol); }
  .sfoot { display: flex; justify-content: space-between; align-items: center; padding: .55em .6em .55em 1.2em; border-top: 1px solid var(--line); font: .88em/1.2 var(--mono); color: var(--muted); }
  .gear { width: 1.15em; height: 1.15em; margin-right: .5em; }

  /* ---------- toolbar ---------- */
  .main { position: relative; min-width: 0; display: flex; flex-direction: column; }
  .toolbar { height: 4em; display: flex; align-items: center; gap: 1em; padding: 0 1em 0 1.5em; }
  .stoggle { flex: none; width: 1.25em; height: 1.25em; margin-right: -.3em; color: var(--muted); }
  .ttl { flex: 1; min-width: 0; display: grid; white-space: nowrap; overflow: hidden; }
  .tv { grid-area: 1 / 1; display: flex; align-items: baseline; gap: .7em; }
  .tv b { font-size: 1.4em; font-weight: 700; letter-spacing: -.01em; }
  .tsub { min-width: 0; overflow: hidden; text-overflow: ellipsis; font: 500 .95em/1 var(--mono); color: var(--muted); }
  .seg {
    position: relative; display: flex; gap: .3em; padding: .15em; border-radius: .46em;
    background: color-mix(in srgb, var(--fg) 6%, transparent); font: .92em/1.85 var(--mono); color: var(--muted); white-space: nowrap;
  }
  .seg > span:not(.thumb) { position: relative; padding: 0 .75em; border-radius: .3em; }
  .seg .t-w { color: var(--accent); }
  .thumb {
    position: absolute; top: .15em; bottom: .15em; left: var(--wx); width: var(--ww); border-radius: .3em;
    background: color-mix(in srgb, var(--accent) 16%, var(--bg)); box-shadow: 0 1px 2px rgb(0 0 0 / .25), inset 0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .tnav { display: flex; font: .92em/2 var(--mono); border: 1px solid color-mix(in srgb, var(--muted) 55%, transparent); border-radius: .3em; }
  .tnav span { padding: 0 .65em; color: var(--muted); }
  .tnav .today { color: var(--fg); border-inline: 1px solid color-mix(in srgb, var(--muted) 55%, transparent); }
  .new { padding: 0 .75em; font: 700 .92em/2.1 var(--mono); background: var(--accent); color: var(--on-accent); border-radius: .3em; white-space: nowrap; }

  /* ---------- views: the week underneath, the agenda on top for the first part of the loop ---------- */
  .views { position: relative; flex: 1; display: flex; flex-direction: column; }
  .wkv { flex: 1; display: flex; flex-direction: column; }

  /* ---------- time grid ---------- */
  .heads, .allday { display: grid; grid-template-columns: 4.3em minmax(0, 1fr); }
  .heads { grid-template-columns: 4.3em repeat(7, minmax(0, 1fr)); height: 2.6em; border-top: 1px solid var(--line); }
  .dh { display: flex; align-items: center; justify-content: center; gap: .45em; border-left: 1px solid var(--line); font: .8em/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; overflow: hidden; }
  .dw { color: var(--muted); }
  .num { font-weight: 600; font-size: 1.24em; letter-spacing: 0; padding: .15em .3em; border-radius: .3em; }
  .dh.today .dw { color: var(--pink); }
  .dh.today .num { background: var(--pink); color: var(--on-accent); }
  .allday { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line-strong); }
  .adg { padding: .7em .6em 0 0; text-align: right; font: .73em/1 var(--mono); color: var(--muted); }
  .adcells { position: relative; min-height: 2.15em; background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px calc(100% / 7)); }
  .grid { position: relative; flex: 1; min-height: 26em; }
  .hr { position: absolute; left: 0; right: 0; top: calc(var(--s) * 100% / 9); border-top: 1px solid var(--line); }
  .hr span { position: absolute; left: 0; width: 3.8em; text-align: right; transform: translateY(-50%); font: .77em/1 var(--mono); color: var(--muted); background: var(--bg); }
  .hr:first-child span { transform: translateY(15%); }
  .cols { position: absolute; inset: 0 0 0 4.3em; background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px calc(100% / 7)); }
  .tcol { position: absolute; inset: 0 auto 0 calc(var(--c, 0) * 100% / 7); width: calc(100% / 7); background: color-mix(in srgb, var(--pink) 3%, transparent); }

  /* events: calendar colour in --k, soft tint + 2px left border, square corners */
  .ev {
    --w: calc(100% / 7); position: absolute; z-index: 1; overflow: hidden; display: flex; flex-direction: column;
    left: calc(var(--c, 0) * var(--w) + 1px); width: calc(var(--w) - 3px);
    top: calc(var(--s) * 100% / 9 + 1px); height: calc(var(--n) * 100% / 9 - 2px);
    padding: .2em .45em .2em .5em; font-size: .85em; line-height: 1.3;
    background: color-mix(in srgb, var(--k) var(--ev-mix), var(--bg)); color: color-mix(in srgb, var(--k) var(--ev-text-mix), var(--fg)); border-left: 2px solid var(--k);
    animation: ev var(--T) var(--d, 0s) infinite both;
  }
  .ev b, .ev small { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ev b { font-weight: 600; }
  .ev small { font: .9em/1.3 var(--mono); opacity: .8; }
  .ev.short { flex-direction: row; align-items: center; gap: .5em; padding-block: 0; }
  .ev.short b { flex: 0 1 auto; min-width: 1.5em; }
  .ev.short small { flex: 0 100 auto; min-width: 0; }
  .ev.past { opacity: .55; }
  .ev.work { --k: var(--work); } .ev.pers { --k: var(--pers); } .ev.icl { --k: var(--icl); } .ev.hol { --k: var(--hol); }
  .ev.half1 { width: calc(var(--w) / 2 - 2px); }
  .ev.half2 { left: calc(var(--c, 0) * var(--w) + var(--w) / 2); width: calc(var(--w) / 2 - 2px); }
  .ev.ad { top: .25em; height: 1.65em; justify-content: center; padding-block: 0; }
  /* The week takes over at 30% of the loop; everything in it drops in from there */
  @keyframes ev { 0%, 30% { opacity: 0; transform: translateY(-.5em); } 33%, 97% { opacity: var(--o, 1); transform: none; } 100% { opacity: 0; } }
  .ev.past { --o: .55; }
  /* invite: pending (orange stripes, dashed outline) until it's accepted from the popover */
  .ev.invite { animation: ev var(--T) var(--d) infinite both, pending var(--T) infinite both; }
  @keyframes pending {
    0%, 82.5% {
      background: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--orange) 13%, transparent) 0 .38em, transparent .38em .77em), color-mix(in srgb, var(--k) 7%, var(--bg));
      outline: 1px dashed var(--orange); outline-offset: -1px;
    }
    83%, 100% { outline: 1px dashed transparent; outline-offset: -1px; }
  }

  /* now: a strong line on today, faint ones across the other days, and the clock pill in the gutter */
  .now { position: absolute; z-index: 3; left: calc(var(--c, 0) * 100% / 7); width: calc(100% / 7); top: calc(2.33 * 100% / 9); border-top: 2px solid var(--pink); animation: ev var(--T) infinite both; }
  .now::before { content: ''; position: absolute; left: -.3em; top: -.4em; width: .6em; height: .6em; border-radius: 50%; background: var(--pink); }
  .nowall { position: absolute; z-index: 2; left: 0; right: 0; top: calc(2.33 * 100% / 9 + .5px); border-top: 1px solid var(--pink); opacity: .35; }
  .nowclk { position: absolute; z-index: 3; right: calc(100% - 4.1em); top: calc(2.33 * 100% / 9 + 1px); transform: translateY(-50%); padding: .08em .3em; border-radius: .23em; background: var(--pink); color: var(--on-accent); font: 700 .77em/1.2 var(--mono); }

  /* drag-to-create: ghost block (theme accent) grows 10:00 → 12:00, the editor opens, then it becomes a real event */
  .nb { overflow: visible; animation: nb var(--T) infinite both; }
  .nb b, .nb small { animation: nbtext var(--T) infinite both; }
  .dghost { position: absolute; inset: 0; padding: .25em .5em; background: color-mix(in srgb, var(--accent) 18%, var(--bg)); border-left: 2px solid var(--accent); margin-left: -2px; color: var(--accent); font: 600 .9em/1.4 var(--mono); white-space: nowrap; overflow: hidden; opacity: 0; animation: dghost var(--T) infinite both; }
  @keyframes nb { 0%, 42% { opacity: 0; height: calc(.5 * 100% / 9 - 2px); } 43% { opacity: 1; height: calc(.5 * 100% / 9 - 2px); } 50%, 97% { opacity: 1; height: calc(2 * 100% / 9 - 2px); } 100% { opacity: 0; } }
  @keyframes dghost { 0%, 42% { opacity: 0; } 43%, 68.5% { opacity: 1; } 69%, 100% { opacity: 0; } }
  @keyframes nbtext { 0%, 68.5% { opacity: 0; } 70%, 100% { opacity: 1; } }

  .cur { position: absolute; z-index: 9; width: 1.2em; opacity: 0; filter: drop-shadow(0 1px 2px rgb(0 0 0 / .6)); }
  .cur :global(svg) { display: block; fill: #fff; stroke: #000; stroke-width: 1; }
  .c1 { right: -.5em; bottom: -1em; animation: c1 var(--T) infinite both; }
  @keyframes c1 { 0%, 39% { opacity: 0; transform: translate(5em, 4em); } 40.5% { opacity: 1; transform: translate(5em, 4em); } 42.5%, 50% { opacity: 1; transform: none; } 51.5%, 100% { opacity: 0; } }

  /* ---------- agenda (views/Agenda.css): today's list on the left, the focus card on the right ---------- */
  .agv {
    position: absolute; inset: 0; z-index: 5; display: grid; grid-template-columns: minmax(0, 1fr) 21em; gap: 1.8em; align-items: start;
    padding: 1.1em 1.5em; background: var(--bg); border-top: 1px solid var(--line); overflow: hidden;
    opacity: 0; visibility: hidden; animation: agv var(--T) infinite both;
  }
  .wkv { animation: wkv var(--T) infinite both; }
  @keyframes agv { 0% { opacity: 0; visibility: visible; } 2%, 27% { opacity: 1; visibility: visible; } 30%, 100% { opacity: 0; visibility: hidden; } }
  @keyframes wkv { 0% { opacity: 1; } 2%, 27% { opacity: 0; } 30%, 100% { opacity: 1; } }
  .aglist { min-width: 0; }
  .agrows { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .agrow {
    position: relative; display: grid; grid-template-columns: 3.4em 3px minmax(0, 1fr); align-items: center; gap: .77em;
    padding: .54em var(--pill-room, 4.9em) .54em .6em; border-radius: .3em; animation: agin var(--T) calc(var(--i, 0) * .06s) infinite both;
  }
  @keyframes agin { 0% { opacity: 0; transform: translateY(3px); } 2.5%, 100% { opacity: var(--o, 1); transform: none; } }
  .agrow.work { --k: var(--work); } .agrow.pers { --k: var(--pers); } .agrow.icl { --k: var(--icl); }
  .agrow.sel { background: color-mix(in srgb, var(--k) 10%, transparent); }
  .agrow.past { --o: .45; }
  .agt { font: .92em/1 var(--mono); color: var(--muted); }
  .agrow.live .agt { color: var(--green); }
  .agbar { align-self: stretch; border-radius: 1px; background: var(--k); }
  .agm { min-width: 0; display: grid; gap: .23em; }
  .agm b { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .agm small { font: .88em/1.3 var(--mono); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .agm :global(.live) { color: var(--green); }
  .pill { position: absolute; right: .6em; top: 50%; transform: translateY(-50%); padding: 0 .77em; border-radius: .23em; background: var(--green); color: var(--bg); font: 700 .85em/1.7em var(--mono); }
  .agnow { position: relative; height: 0; margin: .4em 0 .4em 4em; border-top: 2px solid var(--pink); }
  .agnow::before { content: ''; position: absolute; left: -.3em; top: -.4em; width: .6em; height: .6em; border-radius: 50%; background: var(--pink); }
  .agnow span { position: absolute; right: 0; top: 0; transform: translateY(-50%); padding: .08em .3em; border-radius: .23em; background: var(--pink); color: var(--on-accent); font: 700 .77em/1.2 var(--mono); }
  .aggap { margin-left: 4.8em; padding: 1px 0; font: .77em/1.2 var(--mono); color: color-mix(in srgb, var(--muted) 70%, transparent); }
  /* "Next 7 days" opens a little after the list settles */
  .agahead { position: relative; display: flex; align-items: center; gap: .55em; margin-top: .77em; padding: .6em; border-top: 1px dashed var(--line-strong); font: .88em/1 var(--mono); color: var(--muted); animation: ahead var(--T) infinite both; }
  .agahead em { font-style: normal; }
  .agahead .x2 { position: absolute; left: 2.2em; }
  .chev { transform: rotate(90deg); animation: chev var(--T) infinite both; }
  .chev :global(svg) { width: .9em; height: .9em; stroke-width: 1.6; }
  .agup { display: grid; gap: 1.1em; margin-top: .45em; animation: agup var(--T) infinite both; }
  .agdh { margin: 0 0 .45em .6em; font: 600 .8em/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .agahead .x1 { animation: out0 var(--T) infinite both; }
  .agahead .x2 { animation: in0 var(--T) infinite both; }
  @keyframes ahead { 0%, 9% { color: var(--muted); } 10%, 100% { color: var(--fg); } }
  @keyframes chev { 0%, 9% { transform: rotate(90deg); } 10%, 100% { transform: rotate(-90deg); } }
  @keyframes agup { 0%, 9.5% { opacity: 0; transform: translateY(3px); } 11%, 100% { opacity: 1; transform: none; } }
  @keyframes in0 { 0%, 9% { opacity: 0; } 10%, 100% { opacity: 1; } }
  @keyframes out0 { 0%, 9% { opacity: 1; } 10%, 100% { opacity: 0; } }

  /* focus card: rounded, so the calendar colour is a straight inset bar drawn as a background layer */
  .agf {
    --k: var(--work); padding: 1.4em 1.5em 1.4em 1.7em; border: 1px solid var(--line-strong); border-radius: .46em;
    background: linear-gradient(var(--k), var(--k)) 0 1.1em / 3px calc(100% - 2.2em) no-repeat, var(--surface);
    animation: agin var(--T) .2s infinite both;
  }
  .agst { font: 600 .85em/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--green); }
  .agst::before { content: ''; display: inline-block; width: .46em; height: .46em; margin-right: .54em; border-radius: 50%; background: var(--green); vertical-align: .08em; animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  .agft { display: block; margin: .77em 0 .3em; font-size: 1.46em; font-weight: 700; letter-spacing: -.01em; }
  .agfw { font: .96em/1.4 var(--mono); }
  .agfw span { color: var(--muted); }
  .agf dl { display: grid; grid-template-columns: 5.8em minmax(0, 1fr); gap: .3em .77em; margin: 1.2em 0 0; }
  .agf dt { font: .8em/1.8 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .agf dd { margin: 0; min-width: 0; line-height: 1.46; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .agf dd i { display: inline-block; width: .54em; height: .54em; border-radius: .15em; background: var(--k); }
  .agf .url { font: .92em/1.58 var(--mono); color: var(--cyan); }
  .agacts { display: flex; gap: .6em; margin-top: 1.4em; }
  .join { flex: 1; text-align: center; border-radius: .3em; background: var(--green); color: var(--bg); font: 700 1em/2.6em var(--mono); }
  .join kbd { display: inline; min-width: 0; margin-left: .6em; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-weight: 400; opacity: .6; }
  .det { font-size: .92em; line-height: 2.8em; background: none; }

  /* Week tab click at ~27%: thumb, active tab, title and status-bar mode all follow */
  .thumb { animation: thumb var(--T) infinite both; }
  .seg .t-a { animation: tabA var(--T) infinite both; }
  .seg .t-w { animation: tabW var(--T) infinite both; }
  .tw, .sw { animation: inW var(--T) infinite both; }
  .ta, .sa { animation: outW var(--T) infinite both; }
  @keyframes thumb { 0%, 27.5% { left: .15em; width: var(--aw); } 29%, 100% { left: var(--wx); width: var(--ww); } }
  @keyframes tabA { 0%, 27.5% { color: var(--accent); } 28.5%, 100% { color: var(--muted); } }
  @keyframes tabW { 0%, 27.5% { color: var(--muted); } 28.5%, 100% { color: var(--accent); } }
  @keyframes inW { 0%, 27.5% { opacity: 0; } 29%, 100% { opacity: 1; } }
  @keyframes outW { 0%, 27.5% { opacity: 1; } 29%, 100% { opacity: 0; } }
  .c0 { left: 50%; top: 60%; animation: c0 var(--T) infinite both; }
  @keyframes c0 {
    0%, 22% { opacity: 0; transform: translate(4em, 7em); }
    23% { opacity: 1; transform: translate(4em, 7em); }
    26%, 27% { opacity: 1; transform: none; }
    27.5% { opacity: 1; transform: scale(.85); }
    28%, 29% { opacity: 1; transform: none; }
    30.5%, 100% { opacity: 0; transform: none; }
  }

  /* ---------- status bar ---------- */
  .status { grid-column: 1 / -1; display: flex; align-items: stretch; height: 1.9em; background: var(--surface); border-top: 1px solid var(--line); font: .85em/1.9em var(--mono); color: var(--muted); white-space: nowrap; overflow: hidden; }
  .status > span { flex: none; }
  .mode, .rng { display: grid; }
  .mode > span, .rng > span { grid-area: 1 / 1; }
  .mode { padding: 0 .8em; background: var(--accent); color: var(--on-accent); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .seg-s { padding: 0 1em; border-right: 1px solid var(--line); }
  .sev { color: var(--fg); }
  .sdot { font-style: normal; color: var(--work); }
  .status > .grow { flex: 1; }
  .invc { padding: 0 1em; border-left: 1px solid var(--line); color: var(--orange); animation: invc var(--T) infinite both; }
  @keyframes invc { 0%, 82.5% { opacity: 1; } 83%, 100% { opacity: 0; } }

  /* ---------- invites popover (opens upward from the status bar) ---------- */
  .pop {
    position: absolute; z-index: 7; right: .5em; bottom: 2.2em; width: 26em; padding: .8em 0 .5em;
    background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: .6em; box-shadow: 0 1.4em 3.8em rgb(0 0 0 / .55);
    opacity: 0; visibility: hidden; animation: pop var(--T) infinite both;
  }
  .ptitle { padding: 0 1.1em .6em; font: 600 .8em/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
