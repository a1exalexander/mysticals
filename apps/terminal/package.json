{
  "name": "mysticals",
  "version": "0.1.0",
  "description": "Isolated multi-account calendar for the terminal on macOS, Linux and Windows",
  "keywords": ["calendar", "cli", "tui", "terminal", "google-calendar", "caldav", "macos", "linux", "windows"],
  "author": "Oleksandr Ratushnyi",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/a1exalexander/mysticals.git", "directory": "apps/terminal" },
  "type": "module",
  "bin": { "mysticals": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "ical.js": "^2.2.1",
    "ink": "^6.8.0",
    "react": "^19.3.0",
    "tsdav": "^2.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mysticals/core": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
