{
  "name": "@mysticals/desktop",
  "productName": "mysticals",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated multi-account calendar for macOS",
  "main": "./out/main/index.js",
  "author": "Oleksandr Ratushnyi",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
